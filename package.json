{
  "name": "vedicneev",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "clean": "turbo run clean && rimraf node_modules",
    "db:generate": "npm run generate --workspace=@vedicneev/db",
    "db:push": "npm run db:push --workspace=@vedicneev/db",
    "db:seed": "npm run db:seed --workspace=@vedicneev/db"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "packageManager": "npm@11.13.0",
  "dependencies": {
    "razorpay": "^2.9.8"
  }
}
