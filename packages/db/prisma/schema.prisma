// Vedic Neev — Prisma schema
// Backed by Supabase PostgreSQL. DATABASE_URL is the pooled (pgbouncer) connection
// used at runtime; DIRECT_URL is the direct connection used for migrations.
//
// Convention: Prisma fields are camelCase (idiomatic in the generated TS client);
// every field maps to a snake_case Postgres column via @map for a conventional
// Postgres schema underneath.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────

enum UserRole {
  STUDENT
  PARENT
  ADMIN
}

// Lowercased enum value = the language-code key used inside every Question
// (and Section/Topic/ExamTemplate/MediaItem) Json field, e.g. HI -> "hi".
// EN is the one language every localized Json field is guaranteed to carry;
// the rest are filled in incrementally as translations are authored.
enum Language {
  EN
  HI
  MR // Marathi
  BN // Bengali
  TA // Tamil
  GU // Gujarati
}

enum ExamType {
  JNVST
  AISSEE
  RMS
  DPS
  OTHER
}

// Grade-level classification for Topic/Question content — distinct from
// User.targetClass (a raw Int grade like 5/6/8/9 for a student's own
// profile) and from apps/web's client-side TargetClass type (5|6|8|9,
// same student-profile concept). This enum only classifies which grade
// band a practice topic/question was authored for, starting with the two
// grades this content bank currently supports.
enum ContentClassLevel {
  CLASS_6
  CLASS_9
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum TestSessionStatus {
  IN_PROGRESS
  SUBMITTED
  ABANDONED
}

enum MistakeTagCategory {
  CARELESS_RUSHED
  CALCULATION_GAP
  CONCEPT_GAP
}

enum Locality {
  RURAL
  URBAN
}

enum QuotaCategory {
  GEN
  OBC
  SC
  ST
  DEFENSE
}

enum SubscriptionPlan {
  FREE_EXPLORER
  EXAM_PASS
  VEDIC_ALL_ACCESS
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum MediaType {
  SHORT_VIDEO
  AUDIO_POD
  CONCEPT_CLINIC
}

enum BlogPostStatus {
  DRAFT
  PUBLISHED
}

enum ProductType {
  MOCK_SERIES
  QUESTION_BOOKLET
  OMR_KIT
  LIVE_BOOTCAMP
  MEGA_BUNDLE
}

enum PromoDiscountType {
  PERCENTAGE
  FIXED
}

enum PurchaseStatus {
  PENDING
  PAID
  FAILED
}

// ─────────────────────────────────────────────────────────────────────────
// National Sprints: free, time-synchronized weekly scholarship tests open
// to guests as well as signed-in parents. Ranks and Gold/Silver/Bronze
// badges are deliberately never persisted — they're derived live from
// SprintSubmission rows at read time (see the leaderboard route), so a
// mid-window leaderboard never goes stale as more students submit.
// ─────────────────────────────────────────────────────────────────────────

// One scheduled sprint — a fixed [startTime, endTime] window during which
// every registered participant takes the same paper, assembled from the
// linked ExamTemplate via the same pipeline /exam/live/[templateSlug]
// already uses (see generateLiveMockSession in jnvstMockService.ts).
model NationalSprint {
  id       String   @id @default(cuid())
  // Bilingual, e.g. { "en": "JNVST Class 9 National Sprint — 12 Oct", "hi": "..." }
  title    Json
  examType ExamType @map("exam_type")
  classLevel Int    @map("class_level")

  examTemplateId String       @map("exam_template_id")
  examTemplate   ExamTemplate @relation(fields: [examTemplateId], references: [id], onDelete: Restrict)

  startTime DateTime @map("start_time")
  endTime   DateTime @map("end_time")
  isActive  Boolean  @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  registrations SprintRegistration[]

  @@index([examType, classLevel])
  @@index([startTime])
  @@map("national_sprints")
}

// A participant's entry into one sprint — guest (participantName/phone/
// email captured directly) or linked to a signed-in parent's User row via
// userId. Either way every registration carries its own participant
// snapshot fields, since a "student" profile only exists client-side in
// this app (see useAuthStore's StudentProfile) — there's no server-side
// student row to join through. Deduped by (sprintId, phone), the one
// identity key both paths always have, so a guest or a signed-in parent
// re-registering with the same number reuses their existing entry rather
// than creating a second one.
model SprintRegistration {
  id       String         @id @default(cuid())
  sprintId String         @map("sprint_id")
  sprint   NationalSprint @relation(fields: [sprintId], references: [id], onDelete: Cascade)

  // Set when a signed-in parent registered — optional, since a guest has
  // no User row at all.
  userId String? @map("user_id")
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  participantName String  @map("participant_name")
  // Raw digits, matching User.phone's existing convention.
  phone           String
  email           String?
  // State name/code, shown on the leaderboard's state filter — free text
  // against StateConfiguration's known set, not FK-enforced (a sprint can
  // launch in a state that hasn't been onboarded into that table yet).
  state           String

  registeredAt DateTime @default(now()) @map("registered_at")

  submission SprintSubmission?

  @@unique([sprintId, phone])
  @@index([sprintId, state])
  @@map("sprint_registrations")
}

// Exactly one per SprintRegistration (@unique below) — the FK's own
// uniqueness is what actually enforces "single attempt", not
// application-level logic alone.
model SprintSubmission {
  id             String             @id @default(cuid())
  registrationId String             @unique @map("registration_id")
  registration   SprintRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  totalScore       Float    @map("total_score")
  maxScore         Float    @map("max_score")
  timeTakenSeconds Int      @map("time_taken_seconds")
  submittedAt      DateTime @default(now()) @map("submitted_at")

  @@map("sprint_submissions")
}

// ─────────────────────────────────────────────────────────────────────────
// Identity
// ─────────────────────────────────────────────────────────────────────────

model User {
  id                String    @id @default(cuid())
  // Phone-first auth (OTP); email is optional/secondary.
  phone             String    @unique
  phoneVerifiedAt   DateTime? @map("phone_verified_at")
  email             String?   @unique
  name              String?
  role              UserRole  @default(STUDENT)
  languagePreference Language @default(EN) @map("language_preference")
  targetExam        ExamType? @map("target_exam")
  // Target grade for a STUDENT profile, e.g. 5, 6, 8, 9 — null for PARENT accounts.
  targetClass    Int?            @map("target_class")
  locality       Locality?
  quotaCategory  QuotaCategory?  @map("quota_category")

  // A STUDENT account may be linked to a PARENT account that manages it.
  parentId String? @map("parent_id")
  parent   User?   @relation("ParentChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children User[]  @relation("ParentChildren")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  testSessions        TestSession[]
  mistakes            MistakeVault[]
  subscriptions       Subscription[]
  offlineMockSessions OfflineMockSession[]
  purchases           Purchase[]
  sprintRegistrations SprintRegistration[]

  @@index([parentId])
  @@map("users")
}

// A single-use login code for the WhatsApp-delivered OTP flow
// (apps/web/app/api/auth/whatsapp-otp/route.ts) — a from-scratch OTP
// mechanism (not Supabase's built-in phone provider, which only delivers
// via a configured third-party SMS gateway) so codes can be sent over the
// WhatsApp Cloud API credentials this project already has for report
// delivery. codeHash is a salted hash, never the plaintext code, so a DB
// read alone can't yield a valid login. Rows aren't deleted on expiry —
// there's no cleanup job in this pass; an expired/consumed row is just
// never matched by a lookup again, and no query here scans the whole table.
model PhoneOtp {
  id    String @id @default(cuid())
  // Whatever format the caller sent — matches User.phone's raw digits.
  phone String

  codeHash   String    @map("code_hash")
  expiresAt  DateTime  @map("expires_at")
  // Null until a correct verify consumes it; a consumed or expired row is
  // never accepted again even if the code is resubmitted.
  consumedAt DateTime? @map("consumed_at")
  // Failed verify attempts against this code — capped in the route so a
  // 6-digit code can't be brute-forced within its expiry window.
  attempts   Int       @default(0)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([phone, expiresAt])
  @@map("phone_otps")
}

// A parent's billing plan. targetExam scopes an EXAM_PASS to one exam;
// it's null for FREE_EXPLORER (no exam-specific access) and for
// VEDIC_ALL_ACCESS (every exam is included).
model Subscription {
  id       String @id @default(cuid())
  parentId String @map("parent_id")
  parent   User   @relation(fields: [parentId], references: [id], onDelete: Cascade)

  plan       SubscriptionPlan
  targetExam ExamType?           @map("target_exam")
  status     SubscriptionStatus  @default(ACTIVE)

  // Amount actually paid, in INR (0 for FREE_EXPLORER).
  amountPaid Float @map("amount_paid")

  razorpayOrderId   String? @map("razorpay_order_id")
  razorpayPaymentId String? @map("razorpay_payment_id")

  // Null means no expiry (e.g. a lifetime/free plan); set for paid plans.
  validUntil DateTime? @map("valid_until")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([parentId])
  @@map("subscriptions")
}

// ─────────────────────────────────────────────────────────────────────────
// Storefront: one-time digital product purchases + influencer promo codes.
// Deliberately separate from Subscription above — that's a recurring
// plan-tier paywall (FREE_EXPLORER/EXAM_PASS/VEDIC_ALL_ACCESS), this is a
// per-SKU one-time purchase (mock series, PDFs, OMR kits, bootcamp access),
// so they're independent commercial concepts, not a fork of one another.
// ─────────────────────────────────────────────────────────────────────────

// A purchasable digital SKU (mock series, question booklet PDF, OMR kit,
// 30-day live bootcamp, or the mega bundle). fileUrl follows the same
// convention as MediaItem.videoUrl/OfflineMockSession.scannedImageUrl — a
// plain pre-hosted URL (Supabase Storage or elsewhere), populated by
// seeding/manual entry; there's no in-app upload pipeline in this project.
model Product {
  id          String @id @default(cuid())
  // Bilingual, e.g. { "en": "...", "hi": "..." }
  title       Json
  description Json

  // Null means every exam (mirrors how targetExam already means "agnostic"
  // when null elsewhere in this schema, e.g. MediaItem.targetExams/Topic).
  targetExam ExamType? @map("target_exam")
  // Null means both Class 6 and Class 9 — the equivalent "universal" value
  // for this field, since ContentClassLevel has no explicit BOTH member.
  targetClass ContentClassLevel? @map("target_class")

  productType ProductType @map("product_type")

  // MRP shown struck through next to sellingPrice's anchor-priced discount.
  displayPrice Float   @map("display_price")
  sellingPrice Float   @map("selling_price")
  fileUrl      String? @map("file_url")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  purchases Purchase[]

  @@index([productType])
  @@map("products")
}

// An influencer's discount/affiliate-attribution code. usageCount only
// increments on a confirmed PAID purchase (see /api/webhook/payment), never
// on checkout attempt, so it always reflects real conversions.
model PromoCode {
  id             String            @id @default(cuid())
  code           String            @unique
  discountType   PromoDiscountType @map("discount_type")
  // A percentage (0-100) for PERCENTAGE, or a flat INR amount for FIXED.
  discountValue  Float             @map("discount_value")
  influencerName String            @map("influencer_name")
  // Revenue-share percentage owed to the influencer, e.g. 40.0 for 40%.
  commissionRate Float             @map("commission_rate")
  usageCount     Int               @default(0) @map("usage_count")
  isActive       Boolean           @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")

  purchases Purchase[]

  @@map("promo_codes")
}

// One product line in a checkout — a 1-click order-bump (e.g. adding the
// OMR Kit to a Mock Series purchase) creates two Purchase rows sharing the
// same razorpayOrderId, not a single multi-product row, since each SKU
// needs its own entitlement/fulfillment record.
//
// razorpayOrderId/razorpayPaymentId aren't @unique, matching Subscription's
// same documented tradeoff above (an optimistic app-level idempotency check
// in the webhook handler, not a DB-enforced one) — see
// app/api/webhook/payment/route.ts.
model Purchase {
  id String @id @default(cuid())

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  status     PurchaseStatus @default(PENDING)
  amountPaid Float          @map("amount_paid")

  promoCodeId String?    @map("promo_code_id")
  promoCode   PromoCode? @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)

  razorpayOrderId   String? @map("razorpay_order_id")
  razorpayPaymentId String? @map("razorpay_payment_id")

  // LIVE_BOOTCAMP only: when the 30-day sprint's day-1 window started (set
  // on first visit to the bootcamp card in /dashboard/library, not at
  // purchase time, so a student who buys but starts a week later still
  // gets a full 30 days). Null for every other productType.
  bootcampStartedAt DateTime? @map("bootcamp_started_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([productId])
  @@index([razorpayOrderId])
  @@map("purchases")
}

// ─────────────────────────────────────────────────────────────────────────
// Exam structure: templates (rules) + sections/topics (subject taxonomy)
// ─────────────────────────────────────────────────────────────────────────

model ExamTemplate {
  id       String   @id @default(cuid())
  examType ExamType @map("exam_type")
  // Grade this template applies to — JNVST/AISSEE/RMS each admit primarily
  // at Class 6, with a smaller Class 9 lateral-entry stream; defaults to 6
  // so the existing Class 6 rows need no data migration.
  classLevel Int    @default(6) @map("class_level")
  // Bilingual display name, e.g. { "en": "JNVST Class 6", "hi": "जेएनवीएसटी कक्षा 6" }
  name Json
  slug String @unique

  totalQuestions Int @map("total_questions")
  totalMarks     Int @map("total_marks")
  durationMinutes Int @map("duration_minutes")

  // Default negative-marking ratio applied per wrong answer (e.g. 0.25 marks
  // deducted for 1-mark questions). A section can override this via
  // ExamTemplateSection.negativeMarkingRatio. 0 means no negative marking.
  negativeMarkingRatio Float @default(0) @map("negative_marking_ratio")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sections        ExamTemplateSection[]
  testSessions    TestSession[]
  nationalSprints NationalSprint[]

  @@index([examType, classLevel])
  @@map("exam_templates")
}

// Join model: which sections make up a template, in what order, with what
// per-section question count, marking, and sectional time limit.
model ExamTemplateSection {
  id             String       @id @default(cuid())
  examTemplateId String       @map("exam_template_id")
  examTemplate   ExamTemplate @relation(fields: [examTemplateId], references: [id], onDelete: Cascade)
  sectionId      String       @map("section_id")
  section        Section      @relation(fields: [sectionId], references: [id], onDelete: Restrict)

  order            Int   @default(0)
  questionCount    Int   @map("question_count")
  marksPerQuestion Float @default(1) @map("marks_per_question")

  // Overrides ExamTemplate.negativeMarkingRatio for this section when set.
  negativeMarkingRatio Float? @map("negative_marking_ratio")

  // Sectional time limit in seconds; null means the section shares the
  // exam's overall composite timer instead of its own sectional clock.
  timeLimitSeconds Int? @map("time_limit_seconds")

  @@unique([examTemplateId, sectionId])
  @@map("exam_template_sections")
}

// Top-level subject area, e.g. Mental Ability, Arithmetic, Language, General Knowledge.
model Section {
  id   String @id @default(cuid())
  key  String @unique
  // Bilingual name, e.g. { "en": "Mental Ability", "hi": "मानसिक योग्यता" }
  name  Json
  order Int  @default(0)

  topics                Topic[]
  examTemplateSections  ExamTemplateSection[]
  previousYearQuestions PreviousYearQuestion[]

  @@map("sections")
}

// Sub-topic within a section, e.g. "Pattern Completion" under Mental Ability.
model Topic {
  id        String  @id @default(cuid())
  sectionId String  @map("section_id")
  section   Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  key       String
  // Bilingual name, e.g. { "en": "Pattern Completion", "hi": "पैटर्न पूर्णता" }
  name  Json
  order Int  @default(0)

  // Null means the topic is exam-agnostic (shown to every student regardless
  // of their chosen target exam) — the existing behavior for every topic
  // seeded before this field existed. Set only for topics whose content is
  // genuinely specific to one exam's syllabus (e.g. Sainik School GK vs RMS
  // Current Affairs both live under the same "general_knowledge" section
  // but should never be shown to the other exam's students). Additive,
  // same pattern as Question.figureMetadata/distractorAnalysis.
  targetExam ExamType? @map("target_exam")

  // Null means CLASS_6 — every topic seeded before this field existed is
  // Class 6 content, so null preserves that without a backfill migration
  // (same nullable-means-legacy-default convention as targetExam above,
  // except targetExam's null means "agnostic" while this null means "the
  // one grade this schema originally supported"). Set to CLASS_9 for the
  // Class 9 curriculum expansion's topics.
  targetClass ContentClassLevel? @map("target_class")

  questions  Question[]
  mediaItems MediaItem[]

  @@unique([sectionId, key])
  @@map("topics")
}

// Catalog of Vedic speed-math shortcuts (mirrors @vedicneev/engine's
// speedShortcuts module), linkable from questions that teach/use them.
model VedicSpeedHack {
  id  String @id @default(cuid())
  key String @unique
  // Bilingual title/description, e.g. { "en": "Multiply by 11", "hi": "11 से गुणा करें" }
  title       Json
  description Json

  questions  Question[]
  mediaItems MediaItem[]

  @@map("vedic_speed_hacks")
}

// ─────────────────────────────────────────────────────────────────────────
// Questions
// ─────────────────────────────────────────────────────────────────────────

model Question {
  id  String  @id @default(cuid())
  // Stable natural key every seed-authored question upserts on, e.g.
  // "jnvst6-ma-numseries-01" — never shown to students. See
  // prisma/seed.ts's backfillLegacyQuestionKeys for how the handful of
  // rows that predate this column got one.
  key String @unique @map("question_key")

  topicId    String     @map("topic_id")
  topic      Topic      @relation(fields: [topicId], references: [id], onDelete: Cascade)
  difficulty Difficulty @default(MEDIUM)

  // Multilingual question stem, keyed by lowercased Language enum value, e.g.
  // { "en": "What comes next?", "hi": "आगे क्या आएगा?", "mr": "...", "bn": "...", "ta": "..." }.
  // "en" is always present; regional keys are added incrementally as a
  // state's exam papers get translated (see StateConfiguration below) — the
  // app falls back to "en" for any key that isn't there yet.
  content Json

  // Array of options, each shaped like:
  // { "id": "a", "text": { "en": "...", "hi": "...", "mr"?: "...", ... }, "imageUrl"?: "https://cdn.../fig.svg" }
  // Non-verbal reasoning items may omit `text` and rely on `imageUrl`/inline SVG instead.
  options Json

  // Identifier of the correct entry in `options` (matches that option's "id").
  correctOption String @map("correct_option")

  vedicSpeedHackId String?         @map("vedic_speed_hack_id")
  vedicSpeedHack   VedicSpeedHack? @relation(fields: [vedicSpeedHackId], references: [id], onDelete: SetNull)

  // Multilingual explanation of why `correctOption` is right — step-by-step
  // logical proof or Vedic speed-math shortcut. Same { "en", "hi", ... }
  // shape as `content`.
  explanation          Json?
  explanationVideoUrl  String? @map("explanation_video_url")

  // Multilingual breakdown of why each WRONG option is a common trap answer,
  // keyed by that option's "id" from `options` above (correctOption is never
  // a key here) — e.g. { "b": { "en": "...", "hi": "..." }, "c": {...}, "d":
  // {...} }. Optional and additive alongside `explanation` rather than a
  // rename, so existing readers of `explanation` (jnvstMockService.ts,
  // QuestionCanvas, diagnostics.ts) are unaffected; absent for older rows
  // that predate this field.
  distractorAnalysis Json? @map("distractor_analysis")

  // Inline-SVG (or other vector) diagram for non-verbal reasoning question
  // stems — { "type": "svg", "markup": "<svg>...</svg>" }, matching apps/web/
  // src/lib/exam/types.ts's FigureMetadata and QuestionCanvas.tsx's existing
  // dangerouslySetInnerHTML rendering path for it. Optional and additive
  // alongside `options[].imageUrl` rather than a replacement; absent for
  // every question that doesn't need a diagram.
  figureMetadata Json? @map("figure_metadata")

  // Null means "inherits from Topic.targetExam" (itself null for most
  // topics, meaning exam-agnostic) — set directly on a question only when
  // it needs to diverge from its own topic's tag. In practice this batch
  // sets it to the same value as the owning topic for every question, but
  // the column exists at this granularity for exam-specific items that
  // might later live inside an otherwise-shared topic.
  targetExam ExamType? @map("target_exam")

  // Same inherits-from-Topic convention as targetExam above: null means
  // "use the owning Topic.targetClass" (itself null-means-CLASS_6 for
  // legacy rows). Set directly only when a question needs to diverge from
  // its own topic's grade tag.
  targetClass ContentClassLevel? @map("target_class")

  // Base time allotment in seconds, used by the engine's timer math.
  timeLimitSeconds Int @default(60) @map("time_limit_seconds")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  testResponses TestResponse[]
  mistakes      MistakeVault[]

  @@index([topicId, difficulty])
  @@index([vedicSpeedHackId])
  @@map("questions")
}

// A single item in an exam's Previous-Year-Question practice bank, used to
// assemble dynamic mock papers (see packages/engine's jnvstMockAssembly and
// packages/db/src/jnvstMockService.ts). Deliberately a separate model from
// Question rather than reusing it: the two have genuinely different answer
// representations (correctAnswer here is a 0-3 index into optionsJson,
// matching how PYQ sources are normally keyed, vs. Question's option-"id"
// string) and reusing Question's shape would mean quietly changing that
// established convention everywhere it's already consumed. Content here is
// original practice material modeled on each exam's known section/
// difficulty pattern for that year band, not a claim to reproduce verbatim
// official past papers — this project doesn't have a verified, licensed
// source for those, and presenting fabricated text as an authentic leaked
// paper would be actively misleading. `year` groups practice sets into
// year-styled cohorts, not a citation of a real historical paper.
model PreviousYearQuestion {
  id String @id @default(cuid())
  // Stable natural key to upsert seed content on, e.g. "jnvst-2021-ma-01".
  key String @unique @map("question_key")

  examType   ExamType @default(JNVST) @map("exam_type")
  year       Int
  classLevel Int      @default(6) @map("class_level")

  sectionId String  @map("section_id")
  section   Section @relation(fields: [sectionId], references: [id], onDelete: Restrict)

  // Multilingual question stem — same { "en", "hi", "mr", "bn", "ta" }
  // shape as Question.content; "en" always present.
  questionJson Json @map("question_json")

  // Exactly 4 entries, each a multilingual text map like
  // { "en": "...", "hi": "...", ... } — order matters, since
  // correctAnswer below is a positional index into this array.
  optionsJson Json @map("options_json")

  // 0-based index into optionsJson (0-3) — distinct from Question's
  // option-"id" string; see the model comment above.
  correctAnswer Int @map("correct_answer")

  // Multilingual step-by-step explanation, same shape as questionJson —
  // for Arithmetic this should name the Vedic sutra shortcut that applies
  // (Nikhilam, Urdhva-Tiryagbhyam, etc.) where relevant; for Mental
  // Ability, the elimination logic for the distractor options.
  explanation Json

  // Multilingual breakdown of why each wrong optionsJson entry is a common
  // trap answer, keyed by its stringified 0-based index (e.g. "0","2","3"
  // when correctAnswer is 1) rather than Question.distractorAnalysis's
  // option-id keys, since optionsJson is a positional array with no "id".
  // Optional and additive, same reasoning as Question.distractorAnalysis.
  distractorAnalysis Json? @map("distractor_analysis")

  difficulty Difficulty @default(MEDIUM)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([examType, classLevel, year, sectionId])
  @@map("previous_year_questions")
}

// Which languages a state's exam papers are actually offered in, per exam
// type — e.g. Maharashtra + JNVST -> [EN, HI, MR]; West Bengal + JNVST ->
// [EN, HI, BN]. Deliberately standalone rather than an FK on ExamTemplate:
// an ExamTemplate (e.g. "jnvst-class-6") is one national question set, only
// the paper's available languages vary by state, not the exam structure
// itself. Not yet consumed by any query — a reference table content authors
// and a future "select your state" onboarding step can read from; today's
// exam-runner language switcher (apps/web) offers every Language regardless
// of state and falls back to "en" per-field, per the comment on Question.
model StateConfiguration {
  id        String @id @default(cuid())
  // ISO 3166-2:IN style, e.g. "MH", "WB", "TN".
  stateCode String @map("state_code")
  // Localized display name, e.g. { "en": "Maharashtra", "hi": "महाराष्ट्र" }
  stateName Json   @map("state_name")
  examType  ExamType @map("exam_type")

  activeLanguages Language[] @map("active_languages")
  isActive        Boolean    @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([stateCode, examType])
  @@index([examType])
  @@map("state_configurations")
}

// ─────────────────────────────────────────────────────────────────────────
// Test-taking + remediation
// ─────────────────────────────────────────────────────────────────────────

model TestSession {
  id             String             @id @default(cuid())
  userId         String             @map("user_id")
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  examTemplateId String             @map("exam_template_id")
  examTemplate   ExamTemplate       @relation(fields: [examTemplateId], references: [id], onDelete: Restrict)
  status         TestSessionStatus  @default(IN_PROGRESS)

  startedAt        DateTime  @default(now()) @map("started_at")
  submittedAt      DateTime? @map("submitted_at")
  timeTakenSeconds Float?    @map("time_taken_seconds")

  totalScore Float? @map("total_score")
  maxScore   Float? @map("max_score")
  percentile Float?

  responses TestResponse[]

  @@index([userId, examTemplateId])
  @@map("test_sessions")
}

model TestResponse {
  id            String      @id @default(cuid())
  testSessionId String      @map("test_session_id")
  testSession   TestSession @relation(fields: [testSessionId], references: [id], onDelete: Cascade)
  questionId    String      @map("question_id")
  question      Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  selectedOption   String?  @map("selected_option")
  isCorrect        Boolean? @map("is_correct")
  timeSpentSeconds Float?   @map("time_spent_seconds")
  flaggedForReview Boolean  @default(false) @map("flagged_for_review")

  createdAt DateTime @default(now()) @map("created_at")

  mistake MistakeVault?

  @@unique([testSessionId, questionId])
  @@map("test_responses")
}

// Per-mistake remediation log, tagged by root cause so a student/parent can
// see targeted "what to fix" trends instead of just a raw wrong-answer list.
model MistakeVault {
  id         String @id @default(cuid())
  userId     String @map("user_id")
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String @map("question_id")
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  testResponseId String?       @unique @map("test_response_id")
  testResponse   TestResponse? @relation(fields: [testResponseId], references: [id], onDelete: SetNull)

  tagCategory MistakeTagCategory @map("tag_category")
  note        String?

  resolved   Boolean   @default(false)
  resolvedAt DateTime? @map("resolved_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, tagCategory])
  @@index([userId, questionId])
  @@map("mistake_vault")
}

// ─────────────────────────────────────────────────────────────────────────
// Offline OMR workflow (print a set, scan and grade it later)
// ─────────────────────────────────────────────────────────────────────────

// A printable offline mock set: a fixed batch of questions assigned a
// human-readable serialCode (e.g. "VN-JNV-007") so grading can be
// requested later by that code instead of re-uploading the question set.
// questionIds/answerKey are Json rather than relations because a set is a
// point-in-time snapshot of whatever was actually printed — if the source
// question is edited afterward, an already-printed sheet's key must stay
// exactly what a student has in hand, not silently follow the edit.
model OfflineMockSession {
  id         String @id @default(cuid())
  serialCode String @unique @map("serial_code")

  // Reuses the existing ExamType enum (matches every other exam-typed
  // field in this schema) rather than a free-form String, so this can't
  // drift out of sync with JNVST/AISSEE/RMS/DPS/OTHER.
  examType   ExamType @map("exam_type")
  classLevel Int      @map("class_level")

  totalQuestions Int @map("total_questions")

  // Question ids in print order. Values match Question.id or
  // PreviousYearQuestion.id depending on which bank the set was drawn
  // from — deliberately not a DB-level relation, for the snapshot reason
  // above.
  questionIds Json @map("question_ids")

  // Keyed by question number (1-based, matching the printed sheet) to the
  // correct bubble option. Uses "A"|"B"|"C"|"D" — not a 0-3 index — to
  // match packages/engine/src/omrEvaluator.ts's BubbleOption /
  // OmrAnswerKeyEntry shape exactly, e.g. { "1": "B", "2": "D", ... }, so
  // this can be handed straight to evaluateOmrSheet() with no translation
  // once the scan-and-grade step is built.
  answerKey Json @map("answer_key")

  // Set only when a signed-in student generated this set (vs. an
  // anonymous print, e.g. from a shared library computer).
  userId String? @map("user_id")
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Populated once the filled sheet is scanned and uploaded (Supabase
  // Storage), ahead of grading actually running against it.
  scannedImageUrl String? @map("scanned_image_url")

  // Set once grading has run. Mirrors
  // packages/engine/src/omrEvaluator.ts's OmrSheetEvaluationSummary shape:
  // { responses, totalMarks, correctCount, incorrectCount,
  //   unattemptedCount, invalidCount }.
  gradingResult Json? @map("grading_result")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([examType, classLevel])
  @@map("offline_mock_sessions")
}

// ─────────────────────────────────────────────────────────────────────────
// Media catalog
// ─────────────────────────────────────────────────────────────────────────

// A short/pod/clinic in the media learning library. videoUrl/audioUrl are
// nullable — an item can exist in the catalog (title, description, linked
// topic/hack) before its asset file has actually been uploaded.
model MediaItem {
  id     String    @id @default(cuid())
  // Bilingual title/description, e.g. { "en": "...", "hi": "..." }
  title       Json
  description Json
  mediaType   MediaType @map("media_type")

  durationSeconds Int     @map("duration_seconds")
  videoUrl        String? @map("video_url")
  audioUrl        String? @map("audio_url")
  thumbnailUrl    String? @map("thumbnail_url")
  // Bilingual transcript for the audio-pod player's transcript toggle.
  transcript      Json?

  topicId String? @map("topic_id")
  topic   Topic?  @relation(fields: [topicId], references: [id], onDelete: SetNull)

  vedicSpeedHackId String?         @map("vedic_speed_hack_id")
  vedicSpeedHack   VedicSpeedHack? @relation(fields: [vedicSpeedHackId], references: [id], onDelete: SetNull)

  targetExams ExamType[] @map("target_exams")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([topicId])
  @@index([mediaType])
  @@map("media_items")
}

// ─────────────────────────────────────────────────────────────────────────
// Blog (organic SEO content pipeline)
// ─────────────────────────────────────────────────────────────────────────

// Category is a plain string, not an enum: new categories can be added from
// the admin panel without a schema migration. apps/web's admin/blog code
// defines the canonical starting set of category labels as a shared
// constant for consistent labeling/filtering, without enforcing it here.
model BlogPost {
  id       String         @id @default(cuid())
  title    String
  slug     String         @unique
  category String
  // Short summary — doubles as the article-card blurb and the meta description.
  excerpt String
  // Markdown body, rendered to HTML at request time.
  content String
  status  BlogPostStatus @default(DRAFT)

  // Set when a post transitions DRAFT -> PUBLISHED (via the admin "Publish
  // Now" action); cleared again if it's unpublished back to DRAFT.
  publishedAt DateTime? @map("published_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, publishedAt])
  @@index([category])
  @@map("blog_posts")
}
