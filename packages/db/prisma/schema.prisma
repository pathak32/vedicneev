// Vedic Neev — Prisma schema
// Backed by Supabase PostgreSQL. DATABASE_URL is the pooled (pgbouncer) connection
// used at runtime; DIRECT_URL is the direct connection used for migrations.
//
// Convention: Prisma fields are camelCase (idiomatic in the generated TS client);
// every field maps to a snake_case Postgres column via @map for a conventional
// Postgres schema underneath.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────

enum UserRole {
  STUDENT
  PARENT
  ADMIN
}

// Lowercased enum value = the language-code key used inside every Question
// (and Section/Topic/ExamTemplate/MediaItem) Json field, e.g. HI -> "hi".
// EN is the one language every localized Json field is guaranteed to carry;
// the rest are filled in incrementally as translations are authored.
enum Language {
  EN
  HI
  MR // Marathi
  BN // Bengali
  TA // Tamil
  GU // Gujarati
}

enum ExamType {
  JNVST
  AISSEE
  RMS
  DPS
  OTHER
}

// Grade-level classification for Topic/Question content — distinct from
// User.targetClass (a raw Int grade like 5/6/8/9 for a student's own
// profile) and from apps/web's client-side TargetClass type (5|6|8|9,
// same student-profile concept). This enum only classifies which grade
// band a practice topic/question was authored for, starting with the two
// grades this content bank currently supports.
enum ContentClassLevel {
  CLASS_6
  CLASS_9
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum TestSessionStatus {
  IN_PROGRESS
  SUBMITTED
  ABANDONED
}

enum MistakeTagCategory {
  CARELESS_RUSHED
  CALCULATION_GAP
  CONCEPT_GAP
}

enum Locality {
  RURAL
  URBAN
}

enum QuotaCategory {
  GEN
  OBC
  SC
  ST
  DEFENSE
}

enum SubscriptionPlan {
  FREE_EXPLORER
  EXAM_PASS
  VEDIC_ALL_ACCESS
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum MediaType {
  SHORT_VIDEO
  AUDIO_POD
  CONCEPT_CLINIC
}

enum BlogPostStatus {
  DRAFT
  PUBLISHED
}

enum ProductType {
  MOCK_SERIES
  QUESTION_BOOKLET
  OMR_KIT
  LIVE_BOOTCAMP
  MEGA_BUNDLE
}

enum PromoDiscountType {
  PERCENTAGE
  FIXED
}

enum PurchaseStatus {
  PENDING
  PAID
  FAILED
}

// ─────────────────────────────────────────────────────────────────────────
// National Sprints: free, time-synchronized weekly scholarship tests open
// to guests as well as signed-in parents. Ranks and Gold/Silver/Bronze
// badges are deliberately never persisted — they're derived live from
// SprintSubmission rows at read time (see the leaderboard route), so a
// mid-window leaderboard never goes stale as more students submit.
// ─────────────────────────────────────────────────────────────────────────

// One scheduled sprint — a fixed [startTime, endTime] window during which
// every registered participant takes the same paper, assembled from the
// linked ExamTemplate via the same pipeline /exam/live/[templateSlug]
// already uses (see generateLiveMockSession in jnvstMockService.ts).
model NationalSprint {
  id         String   @id @default(cuid())
  // Bilingual, e.g. { "en": "JNVST Class 9 National Sprint — 12 Oct", "hi": "..." }
  title      Json
  examType   ExamType @map("exam_type")
  classLevel Int      @map("class_level")

  examTemplateId String       @map("exam_template_id")
  examTemplate   ExamTemplate @relation(fields: [examTemplateId], references: [id], onDelete: Restrict)

  startTime DateTime @map("start_time")
  endTime   DateTime @map("end_time")
  isActive  Boolean  @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  registrations SprintRegistration[]

  @@index([examType, classLevel])
  @@index([startTime])
  @@map("national_sprints")
}

// A participant's entry into one sprint — guest (participantName/phone/
// email captured directly) or linked to a signed-in parent's User row via
// userId. Either way every registration carries its own participant
// snapshot fields, since a "student" profile only exists client-side in
// this app (see useAuthStore's StudentProfile) — there's no server-side
// student row to join through. Deduped by (sprintId, phone), the one
// identity key both paths always have, so a guest or a signed-in parent
// re-registering with the same number reuses their existing entry rather
// than creating a second one.
model SprintRegistration {
  id       String         @id @default(cuid())
  sprintId String         @map("sprint_id")
  sprint   NationalSprint @relation(fields: [sprintId], references: [id], onDelete: Cascade)

  // Set when a signed-in parent registered — optional, since a guest has
  // no User row at all.
  userId String? @map("user_id")
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  participantName String  @map("participant_name")
  // Raw digits, matching User.phone's existing convention.
  phone           String
  email           String?
  // State name/code, shown on the leaderboard's state filter — free text
  // against StateConfiguration's known set, not FK-enforced (a sprint can
  // launch in a state that hasn't been onboarded into that table yet).
  state           String

  registeredAt DateTime @default(now()) @map("registered_at")

  submission SprintSubmission?

  @@unique([sprintId, phone])
  @@index([sprintId, state])
  @@map("sprint_registrations")
}

// Exactly one per SprintRegistration (@unique below) — the FK's own
// uniqueness is what actually enforces "single attempt", not
// application-level logic alone.
model SprintSubmission {
  id             String             @id @default(cuid())
  registrationId String             @unique @map("registration_id")
  registration   SprintRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  totalScore       Float    @map("total_score")
  maxScore         Float    @map("max_score")
  timeTakenSeconds Int      @map("time_taken_seconds")
  submittedAt      DateTime @default(now()) @map("submitted_at")

  @@map("sprint_submissions")
}

// ─────────────────────────────────────────────────────────────────────────
// Identity
// ─────────────────────────────────────────────────────────────────────────

model User {
  id                 String         @id @default(cuid())
  // Phone-first auth (OTP); email is optional/secondary.
  phone              String         @unique
  phoneVerifiedAt    DateTime?      @map("phone_verified_at")
  email              String?        @unique
  name               String?
  role               UserRole       @default(STUDENT)
  languagePreference Language       @default(EN) @map("language_preference")
  targetExam         ExamType?      @map("target_exam")
  // Target grade for a STUDENT profile, e.g. 5, 6, 8, 9 — null for PARENT accounts.
  targetClass        Int?           @map("target_class")
  locality           Locality?
  quotaCategory      QuotaCategory? @map("quota_category")

  // A STUDENT account may be linked to a PARENT account that manages it.
  parentId String? @map("parent_id")
  parent   User?   @relation("ParentChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children User[]  @relation("ParentChildren")

  // ── Vedic Mind AI ecosystem (vedicmindai.in, our sibling product) ──────
  // Set from the client-captured `utm_source=vedicmindai` referral (see
  // apps/web/src/lib/ecosystem/attribution.ts) the next time this phone
  // syncs via /api/auth/sync — drives the customized dashboard welcome
  // message for students arriving from that product.
  completedVedicMindBasics Boolean @default(false) @map("completed_vedic_mind_basics")
  // Not yet populated by any flow — reserved so a real account-linking
  // handoff between the two products (once one exists) has a column to
  // write into instead of needing a migration at that point.
  vedicMindAiUserId        String? @map("vedic_mind_ai_user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  testSessions            TestSession[]
  mistakes                MistakeVault[]
  subscriptions           Subscription[]
  offlineMockSessions     OfflineMockSession[]
  purchases               Purchase[]
  sprintRegistrations     SprintRegistration[]
  speedChallengeAttempts  SpeedChallengeAttempt[]
  recentlyServedQuestions RecentlyServedQuestion[]
  // Set only for the one person (per institute) who administers
  // omrtest.vedicneev.com — see InstituteAdmin's own comment on why this
  // reuses the existing User identity instead of a parallel account system.
  instituteAdmin          InstituteAdmin?
  // typingtest.vedicneev.com — see the Typing Test Suite section at the
  // bottom of this file for why these are their own model cluster.
  typingAttempts          TypingAttempt[]
  typingSubscription      TypingSubscription?
  typingCandidateProfile  TypingCandidateProfile?

  @@index([parentId])
  @@map("users")
}

// A single-use login code for the WhatsApp-delivered OTP flow
// (apps/web/src/lib/auth/whatsappOtpServer.ts) — a from-scratch OTP
// mechanism (not Supabase's built-in phone provider, which only delivers
// via a configured third-party SMS gateway) so codes can be sent over the
// WhatsApp Cloud API credentials this project already has for report
// delivery. codeHash is a salted hash, never the plaintext code, so a DB
// read alone can't yield a valid login. Rows aren't deleted on expiry —
// there's no cleanup job in this pass; an expired/consumed row is just
// never matched by a lookup again, and no query here scans the whole table.
model PhoneOtp {
  id    String @id @default(cuid())
  // Whatever format the caller sent — matches User.phone's raw digits.
  phone String

  codeHash   String    @map("code_hash")
  expiresAt  DateTime  @map("expires_at")
  // Null until a correct verify consumes it; a consumed or expired row is
  // never accepted again even if the code is resubmitted.
  consumedAt DateTime? @map("consumed_at")
  // Failed verify attempts against this code — capped in the route so a
  // 6-digit code can't be brute-forced within its expiry window.
  attempts   Int       @default(0)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([phone, expiresAt])
  @@map("phone_otps")
}

// A parent's billing plan. targetExam scopes an EXAM_PASS to one exam;
// it's null for FREE_EXPLORER (no exam-specific access) and for
// VEDIC_ALL_ACCESS (every exam is included).
model Subscription {
  id       String @id @default(cuid())
  parentId String @map("parent_id")
  parent   User   @relation(fields: [parentId], references: [id], onDelete: Cascade)

  plan       SubscriptionPlan
  targetExam ExamType?          @map("target_exam")
  status     SubscriptionStatus @default(ACTIVE)

  // Amount actually paid, in INR (0 for FREE_EXPLORER).
  amountPaid Float @map("amount_paid")

  razorpayOrderId   String? @map("razorpay_order_id")
  razorpayPaymentId String? @map("razorpay_payment_id")

  // Null means no expiry (e.g. a lifetime/free plan); set for paid plans.
  validUntil DateTime? @map("valid_until")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([parentId])
  @@map("subscriptions")
}

// ─────────────────────────────────────────────────────────────────────────
// Storefront: one-time digital product purchases + influencer promo codes.
// Deliberately separate from Subscription above — that's a recurring
// plan-tier paywall (FREE_EXPLORER/EXAM_PASS/VEDIC_ALL_ACCESS), this is a
// per-SKU one-time purchase (mock series, PDFs, OMR kits, bootcamp access),
// so they're independent commercial concepts, not a fork of one another.
// ─────────────────────────────────────────────────────────────────────────

// A purchasable digital SKU (mock series, question booklet PDF, OMR kit,
// 30-day live bootcamp, or the mega bundle). fileUrl follows the same
// convention as MediaItem.videoUrl/OfflineMockSession.scannedImageUrl — a
// plain pre-hosted URL (Supabase Storage or elsewhere), populated by
// seeding/manual entry; there's no in-app upload pipeline in this project.
model Product {
  id          String @id @default(cuid())
  // Bilingual, e.g. { "en": "...", "hi": "..." }
  title       Json
  description Json

  // Null means every exam (mirrors how targetExam already means "agnostic"
  // when null elsewhere in this schema, e.g. MediaItem.targetExams/Topic).
  targetExam  ExamType?          @map("target_exam")
  // Null means both Class 6 and Class 9 — the equivalent "universal" value
  // for this field, since ContentClassLevel has no explicit BOTH member.
  targetClass ContentClassLevel? @map("target_class")

  // Which language the file itself is written in — distinct from
  // title/description's own bilingual Json (that's the storefront's UI
  // copy, always shown in the site's current locale; this is the language
  // of the PDF content a QUESTION_BOOKLET buyer receives). Null means the
  // product isn't a language-specific edition (every non-booklet type
  // today), not "every language" — unlike targetExam/targetClass's null.
  language Language? @map("language")

  productType ProductType @map("product_type")

  // MRP shown struck through next to sellingPrice's anchor-priced discount.
  displayPrice Float   @map("display_price")
  sellingPrice Float   @map("selling_price")
  fileUrl      String? @map("file_url")

  // Admin-editable table of contents — a plain string[] of section/chapter
  // titles, e.g. ["Chapter 1: Mental Ability", "Chapter 2: Arithmetic"] —
  // shown in the Store's preview modal so a visitor can see what's inside
  // before buying, without a real PDF-page-extraction pipeline. Null for
  // products seeded before this field existed.
  previewOutline Json? @map("preview_outline")

  // Curated 2-3 worked examples shown in the pre-purchase preview for
  // MOCK_SERIES/QUESTION_BOOKLET products. Deliberately admin-authored and
  // denormalized here (same {stem, options, correctOptionId, explanation}
  // shape as Question) rather than an FK into the real Question bank —
  // preview content is curated marketing copy, not live bank data, and
  // shouldn't change if the underlying bank question is later edited.
  // Array of PreviewSampleQuestion (see apps/web/src/lib/store/types.ts).
  previewSampleQuestions Json? @map("preview_sample_questions")

  // OMR_KIT preview: a sample A4 sheet image plus short usage instructions,
  // shown in place of sample questions for that product type.
  previewOmrImageUrl     String? @map("preview_omr_image_url")
  previewOmrInstructions Json?   @map("preview_omr_instructions") // string[]

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  purchases Purchase[]

  @@index([productType])
  @@map("products")
}

// An influencer's discount/affiliate-attribution code. usageCount only
// increments on a confirmed PAID purchase (see /api/webhook/payment), never
// on checkout attempt, so it always reflects real conversions.
model PromoCode {
  id             String            @id @default(cuid())
  code           String            @unique
  discountType   PromoDiscountType @map("discount_type")
  // A percentage (0-100) for PERCENTAGE, or a flat INR amount for FIXED.
  discountValue  Float             @map("discount_value")
  influencerName String            @map("influencer_name")
  // Revenue-share percentage owed to the influencer, e.g. 40.0 for 40%.
  commissionRate Float             @map("commission_rate")
  usageCount     Int               @default(0) @map("usage_count")
  isActive       Boolean           @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")

  purchases Purchase[]

  @@map("promo_codes")
}

// One product line in a checkout — a 1-click order-bump (e.g. adding the
// OMR Kit to a Mock Series purchase) creates two Purchase rows sharing the
// same razorpayOrderId, not a single multi-product row, since each SKU
// needs its own entitlement/fulfillment record.
//
// razorpayOrderId/razorpayPaymentId aren't @unique, matching Subscription's
// same documented tradeoff above (an optimistic app-level idempotency check
// in the webhook handler, not a DB-enforced one) — see
// app/api/webhook/payment/route.ts.
model Purchase {
  id String @id @default(cuid())

  // Nullable so checkout can start with zero identity (frictionless guest
  // purchase) — see guestEmail/guestPhone below, collected right after
  // payment success and, if they match an existing User, used to link this
  // row to a real account. Mirrors SprintRegistration's identical guest
  // pattern (optional userId + its own guest contact fields).
  userId String? @map("user_id")
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Guest contact info, collected post-payment via POST
  // /api/checkout/guest-contact — null until then, and null forever for a
  // purchase made by an already-identified user (userId set at checkout).
  guestEmail String? @map("guest_email")
  guestPhone String? @map("guest_phone")

  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  status     PurchaseStatus @default(PENDING)
  amountPaid Float          @map("amount_paid")

  promoCodeId String?    @map("promo_code_id")
  promoCode   PromoCode? @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)

  razorpayOrderId   String? @map("razorpay_order_id")
  razorpayPaymentId String? @map("razorpay_payment_id")

  // LIVE_BOOTCAMP only: when the 30-day sprint's day-1 window started (set
  // on first visit to the bootcamp card in /dashboard/library, not at
  // purchase time, so a student who buys but starts a week later still
  // gets a full 30 days). Null for every other productType.
  bootcampStartedAt DateTime? @map("bootcamp_started_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([productId])
  @@index([razorpayOrderId])
  @@map("purchases")
}

// ─────────────────────────────────────────────────────────────────────────
// Exam structure: templates (rules) + sections/topics (subject taxonomy)
// ─────────────────────────────────────────────────────────────────────────

model ExamTemplate {
  id         String   @id @default(cuid())
  examType   ExamType @map("exam_type")
  // Grade this template applies to — JNVST/AISSEE/RMS each admit primarily
  // at Class 6, with a smaller Class 9 lateral-entry stream; defaults to 6
  // so the existing Class 6 rows need no data migration.
  classLevel Int      @default(6) @map("class_level")
  // Bilingual display name, e.g. { "en": "JNVST Class 6", "hi": "जेएनवीएसटी कक्षा 6" }
  name       Json
  slug       String   @unique

  totalQuestions  Int @map("total_questions")
  totalMarks      Int @map("total_marks")
  durationMinutes Int @map("duration_minutes")

  // Default negative-marking ratio applied per wrong answer (e.g. 0.25 marks
  // deducted for 1-mark questions). A section can override this via
  // ExamTemplateSection.negativeMarkingRatio. 0 means no negative marking.
  negativeMarkingRatio Float @default(0) @map("negative_marking_ratio")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sections                ExamTemplateSection[]
  testSessions            TestSession[]
  nationalSprints         NationalSprint[]
  recentlyServedQuestions RecentlyServedQuestion[]

  @@index([examType, classLevel])
  @@map("exam_templates")
}

// Tracks which questions a student has already been served for a given
// ExamTemplate's live mock (packages/engine's assembleJnvstMock rotation —
// see apps/web/src/lib/exam/jnvstMockService.ts), so the next generated
// paper can prefer not-recently-served items over ones already shown,
// instead of drawing fully at random every time from a bank that's often
// far shallower than "give this student 15+ genuinely fresh papers" would
// need. questionId deliberately isn't a real FK — a live mock can draw
// from either PreviousYearQuestion OR Question depending on the exam/class
// (see QUESTION_BANK_MOCK_SLUGS in jnvstMockService.ts), and no single
// column can carry a foreign key into two different tables. Recorded once
// per (user, template, question) the first time it's served — servedAt is
// only ever set on create, never bumped on a later re-serve, so "oldest
// served" ordering (for an eventual cycle-back once the whole pool has
// been shown) stays meaningful.
model RecentlyServedQuestion {
  id             String       @id @default(cuid())
  userId         String       @map("user_id")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  examTemplateId String       @map("exam_template_id")
  examTemplate   ExamTemplate @relation(fields: [examTemplateId], references: [id], onDelete: Cascade)
  questionId     String       @map("question_id")

  servedAt DateTime @default(now()) @map("served_at")

  @@unique([userId, examTemplateId, questionId])
  @@index([userId, examTemplateId])
  @@map("recently_served_questions")
}

// Join model: which sections make up a template, in what order, with what
// per-section question count, marking, and sectional time limit.
model ExamTemplateSection {
  id             String       @id @default(cuid())
  examTemplateId String       @map("exam_template_id")
  examTemplate   ExamTemplate @relation(fields: [examTemplateId], references: [id], onDelete: Cascade)
  sectionId      String       @map("section_id")
  section        Section      @relation(fields: [sectionId], references: [id], onDelete: Restrict)

  order            Int   @default(0)
  questionCount    Int   @map("question_count")
  marksPerQuestion Float @default(1) @map("marks_per_question")

  // Overrides ExamTemplate.negativeMarkingRatio for this section when set.
  negativeMarkingRatio Float? @map("negative_marking_ratio")

  // Sectional time limit in seconds; null means the section shares the
  // exam's overall composite timer instead of its own sectional clock.
  timeLimitSeconds Int? @map("time_limit_seconds")

  @@unique([examTemplateId, sectionId])
  @@map("exam_template_sections")
}

// Top-level subject area, e.g. Mental Ability, Arithmetic, Language, General Knowledge.
model Section {
  id    String @id @default(cuid())
  key   String @unique
  // Bilingual name, e.g. { "en": "Mental Ability", "hi": "मानसिक योग्यता" }
  name  Json
  order Int    @default(0)

  topics                Topic[]
  examTemplateSections  ExamTemplateSection[]
  previousYearQuestions PreviousYearQuestion[]

  @@map("sections")
}

// Sub-topic within a section, e.g. "Pattern Completion" under Mental Ability.
model Topic {
  id        String  @id @default(cuid())
  sectionId String  @map("section_id")
  section   Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  key       String
  // Bilingual name, e.g. { "en": "Pattern Completion", "hi": "पैटर्न पूर्णता" }
  name      Json
  order     Int     @default(0)

  // Null means the topic is exam-agnostic (shown to every student regardless
  // of their chosen target exam) — the existing behavior for every topic
  // seeded before this field existed. Set only for topics whose content is
  // genuinely specific to one exam's syllabus (e.g. Sainik School GK vs RMS
  // Current Affairs both live under the same "general_knowledge" section
  // but should never be shown to the other exam's students). Additive,
  // same pattern as Question.figureMetadata/distractorAnalysis.
  targetExam ExamType? @map("target_exam")

  // Null means CLASS_6 — every topic seeded before this field existed is
  // Class 6 content, so null preserves that without a backfill migration
  // (same nullable-means-legacy-default convention as targetExam above,
  // except targetExam's null means "agnostic" while this null means "the
  // one grade this schema originally supported"). Set to CLASS_9 for the
  // Class 9 curriculum expansion's topics.
  targetClass ContentClassLevel? @map("target_class")

  questions  Question[]
  mediaItems MediaItem[]

  @@unique([sectionId, key])
  @@map("topics")
}

// Catalog of Vedic speed-math shortcuts (mirrors @vedicneev/engine's
// speedShortcuts module), linkable from questions that teach/use them.
model VedicSpeedHack {
  id          String @id @default(cuid())
  key         String @unique
  // Bilingual title/description, e.g. { "en": "Multiply by 11", "hi": "11 से गुणा करें" }
  title       Json
  description Json

  questions  Question[]
  mediaItems MediaItem[]

  @@map("vedic_speed_hacks")
}

// ─────────────────────────────────────────────────────────────────────────
// Questions
// ─────────────────────────────────────────────────────────────────────────

model Question {
  id  String @id @default(cuid())
  // Stable natural key every seed-authored question upserts on, e.g.
  // "jnvst6-ma-numseries-01" — never shown to students. See
  // prisma/seed.ts's backfillLegacyQuestionKeys for how the handful of
  // rows that predate this column got one.
  key String @unique @map("question_key")

  topicId    String     @map("topic_id")
  topic      Topic      @relation(fields: [topicId], references: [id], onDelete: Cascade)
  difficulty Difficulty @default(MEDIUM)

  // Multilingual question stem, keyed by lowercased Language enum value, e.g.
  // { "en": "What comes next?", "hi": "आगे क्या आएगा?", "mr": "...", "bn": "...", "ta": "..." }.
  // "en" is always present; regional keys are added incrementally as a
  // state's exam papers get translated (see StateConfiguration below) — the
  // app falls back to "en" for any key that isn't there yet.
  content Json

  // Array of options, each shaped like:
  // { "id": "a", "text": { "en": "...", "hi": "...", "mr"?: "...", ... }, "imageUrl"?: "https://cdn.../fig.svg" }
  // Non-verbal reasoning items may omit `text` and rely on `imageUrl`/inline SVG instead.
  options Json

  // Identifier of the correct entry in `options` (matches that option's "id").
  correctOption String @map("correct_option")

  vedicSpeedHackId String?         @map("vedic_speed_hack_id")
  vedicSpeedHack   VedicSpeedHack? @relation(fields: [vedicSpeedHackId], references: [id], onDelete: SetNull)

  // Multilingual explanation of why `correctOption` is right — step-by-step
  // logical proof or Vedic speed-math shortcut. Same { "en", "hi", ... }
  // shape as `content`.
  explanation         Json?
  explanationVideoUrl String? @map("explanation_video_url")

  // Multilingual breakdown of why each WRONG option is a common trap answer,
  // keyed by that option's "id" from `options` above (correctOption is never
  // a key here) — e.g. { "b": { "en": "...", "hi": "..." }, "c": {...}, "d":
  // {...} }. Optional and additive alongside `explanation` rather than a
  // rename, so existing readers of `explanation` (jnvstMockService.ts,
  // QuestionCanvas, diagnostics.ts) are unaffected; absent for older rows
  // that predate this field.
  distractorAnalysis Json? @map("distractor_analysis")

  // Inline-SVG (or other vector) diagram for non-verbal reasoning question
  // stems — { "type": "svg", "markup": "<svg>...</svg>" }, matching apps/web/
  // src/lib/exam/types.ts's FigureMetadata and QuestionCanvas.tsx's existing
  // dangerouslySetInnerHTML rendering path for it. Optional and additive
  // alongside `options[].imageUrl` rather than a replacement; absent for
  // every question that doesn't need a diagram.
  figureMetadata Json? @map("figure_metadata")

  // Null means "inherits from Topic.targetExam" (itself null for most
  // topics, meaning exam-agnostic) — set directly on a question only when
  // it needs to diverge from its own topic's tag. In practice this batch
  // sets it to the same value as the owning topic for every question, but
  // the column exists at this granularity for exam-specific items that
  // might later live inside an otherwise-shared topic.
  targetExam ExamType? @map("target_exam")

  // Same inherits-from-Topic convention as targetExam above: null means
  // "use the owning Topic.targetClass" (itself null-means-CLASS_6 for
  // legacy rows). Set directly only when a question needs to diverge from
  // its own topic's grade tag.
  targetClass ContentClassLevel? @map("target_class")

  // Base time allotment in seconds, used by the engine's timer math.
  timeLimitSeconds Int @default(60) @map("time_limit_seconds")

  // Set once an admin has manually checked this item's correctness for a
  // National Sprint review (see /admin/sprints) — null means not yet
  // reviewed. Never touched by the mock-assembly pipeline itself, only by
  // POST /api/admin/sprint-questions/verify.
  verifiedAt DateTime? @map("verified_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  testResponses TestResponse[]
  mistakes      MistakeVault[]

  @@index([topicId, difficulty])
  @@index([vedicSpeedHackId])
  @@map("questions")
}

// A single item in an exam's Previous-Year-Question practice bank, used to
// assemble dynamic mock papers (see packages/engine's jnvstMockAssembly and
// packages/db/src/jnvstMockService.ts). Deliberately a separate model from
// Question rather than reusing it: the two have genuinely different answer
// representations (correctAnswer here is a 0-3 index into optionsJson,
// matching how PYQ sources are normally keyed, vs. Question's option-"id"
// string) and reusing Question's shape would mean quietly changing that
// established convention everywhere it's already consumed. Content here is
// original practice material modeled on each exam's known section/
// difficulty pattern for that year band, not a claim to reproduce verbatim
// official past papers — this project doesn't have a verified, licensed
// source for those, and presenting fabricated text as an authentic leaked
// paper would be actively misleading. `year` groups practice sets into
// year-styled cohorts, not a citation of a real historical paper.
model PreviousYearQuestion {
  id  String @id @default(cuid())
  // Stable natural key to upsert seed content on, e.g. "jnvst-2021-ma-01".
  key String @unique @map("question_key")

  examType   ExamType @default(JNVST) @map("exam_type")
  year       Int
  classLevel Int      @default(6) @map("class_level")

  sectionId String  @map("section_id")
  section   Section @relation(fields: [sectionId], references: [id], onDelete: Restrict)

  // Multilingual question stem — same { "en", "hi", "mr", "bn", "ta" }
  // shape as Question.content; "en" always present.
  questionJson Json @map("question_json")

  // Exactly 4 entries, each a multilingual text map like
  // { "en": "...", "hi": "...", ... } — order matters, since
  // correctAnswer below is a positional index into this array.
  optionsJson Json @map("options_json")

  // 0-based index into optionsJson (0-3) — distinct from Question's
  // option-"id" string; see the model comment above.
  correctAnswer Int @map("correct_answer")

  // Multilingual step-by-step explanation, same shape as questionJson —
  // for Arithmetic this should name the Vedic sutra shortcut that applies
  // (Nikhilam, Urdhva-Tiryagbhyam, etc.) where relevant; for Mental
  // Ability, the elimination logic for the distractor options.
  explanation Json

  // Multilingual breakdown of why each wrong optionsJson entry is a common
  // trap answer, keyed by its stringified 0-based index (e.g. "0","2","3"
  // when correctAnswer is 1) rather than Question.distractorAnalysis's
  // option-id keys, since optionsJson is a positional array with no "id".
  // Optional and additive, same reasoning as Question.distractorAnalysis.
  distractorAnalysis Json? @map("distractor_analysis")

  difficulty Difficulty @default(MEDIUM)

  // Set once an admin has manually checked this item's correctness for a
  // National Sprint review (see /admin/sprints) — null means not yet
  // reviewed. Never touched by the mock-assembly pipeline itself, only by
  // POST /api/admin/sprint-questions/verify.
  verifiedAt DateTime? @map("verified_at")

  // Groups rows into a specific, fixed mock paper within one
  // (examType, classLevel) — distinct from `year`, which groups rows into a
  // loose practice cohort that JNVST's mock assembly pools and draws from
  // randomly. Defaults to 1 so every pre-existing row (JNVST's whole pool,
  // plus the existing AISSEE/RMS Class 9 pool) is untouched and reads as
  // "paper 1" without a backfill. Only meaningful for the discrete-paper
  // flow in jnvstMockService.ts's generateLiveMockSession — JNVST's
  // whole-pool assembly ignores it entirely.
  paperNumber Int @default(1) @map("paper_number")

  // DRAFT means seeded but not yet admin-approved for students — excluded
  // from every mock-assembly query (see jnvstMockService.ts) and shown only
  // on /admin/mock-papers until an admin publishes it. Defaults to
  // PUBLISHED so every pre-existing row (all boards) keeps its current
  // live behavior with zero backfill.
  reviewStatus PaperReviewStatus @default(PUBLISHED) @map("review_status")

  // Back-relation for MistakeVault.pyqQuestionId — see that model's own
  // comment for why a mistake needs a second FK alongside Question.
  mistakes MistakeVault[]

  // Pre-existing live columns that predate this model gaining a matching
  // Prisma field — adding them here (rather than dropping the columns) so
  // `prisma db push` stops proposing to drop 430 rows of real timestamp
  // data that was never actually unused, just unmodeled.
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([examType, classLevel, year, sectionId])
  @@index([examType, classLevel, paperNumber])
  @@map("previous_year_questions")
}

enum PaperReviewStatus {
  DRAFT
  PUBLISHED
}

// Which languages a state's exam papers are actually offered in, per exam
// type — e.g. Maharashtra + JNVST -> [EN, HI, MR]; West Bengal + JNVST ->
// [EN, HI, BN]. Deliberately standalone rather than an FK on ExamTemplate:
// an ExamTemplate (e.g. "jnvst-class-6") is one national question set, only
// the paper's available languages vary by state, not the exam structure
// itself. Not yet consumed by any query — a reference table content authors
// and a future "select your state" onboarding step can read from; today's
// exam-runner language switcher (apps/web) offers every Language regardless
// of state and falls back to "en" per-field, per the comment on Question.
model StateConfiguration {
  id        String   @id @default(cuid())
  // ISO 3166-2:IN style, e.g. "MH", "WB", "TN".
  stateCode String   @map("state_code")
  // Localized display name, e.g. { "en": "Maharashtra", "hi": "महाराष्ट्र" }
  stateName Json     @map("state_name")
  examType  ExamType @map("exam_type")

  activeLanguages Language[] @map("active_languages")
  isActive        Boolean    @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([stateCode, examType])
  @@index([examType])
  @@map("state_configurations")
}

// ─────────────────────────────────────────────────────────────────────────
// Test-taking + remediation
// ─────────────────────────────────────────────────────────────────────────

model TestSession {
  id             String            @id @default(cuid())
  userId         String            @map("user_id")
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  examTemplateId String            @map("exam_template_id")
  examTemplate   ExamTemplate      @relation(fields: [examTemplateId], references: [id], onDelete: Restrict)
  status         TestSessionStatus @default(IN_PROGRESS)

  startedAt        DateTime  @default(now()) @map("started_at")
  submittedAt      DateTime? @map("submitted_at")
  timeTakenSeconds Float?    @map("time_taken_seconds")

  totalScore Float? @map("total_score")
  maxScore   Float? @map("max_score")
  percentile Float?

  responses TestResponse[]

  @@index([userId, examTemplateId])
  @@map("test_sessions")
}

model TestResponse {
  id            String      @id @default(cuid())
  testSessionId String      @map("test_session_id")
  testSession   TestSession @relation(fields: [testSessionId], references: [id], onDelete: Cascade)
  questionId    String      @map("question_id")
  question      Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  selectedOption   String?  @map("selected_option")
  isCorrect        Boolean? @map("is_correct")
  timeSpentSeconds Float?   @map("time_spent_seconds")
  flaggedForReview Boolean  @default(false) @map("flagged_for_review")

  createdAt DateTime @default(now()) @map("created_at")

  mistake MistakeVault?

  @@unique([testSessionId, questionId])
  @@map("test_responses")
}

// Per-mistake remediation log, tagged by root cause so a student/parent can
// see targeted "what to fix" trends instead of just a raw wrong-answer list.
// A mistake logged against EITHER bank — exactly one of questionId/
// pyqQuestionId is set, never both, never neither. questionId predates
// pyqQuestionId (see git history) and was originally required; it's
// nullable now purely so a PYQ-sourced mistake can omit it, not because a
// row can lack a source question. Every existing consumer (both writers,
// omrGradingService.ts and api/exam/submit/route.ts) already checks the
// PreviousYearQuestion bank as a fallback when a candidate id isn't a real
// Question id, so this FK addition is what finally lets that fallback
// write a row instead of silently skipping the mistake — see each
// writer's own routing comment for the one-FK-per-table constraint this
// was blocked on before.
model MistakeVault {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String?   @map("question_id")
  question   Question? @relation(fields: [questionId], references: [id], onDelete: Cascade)

  pyqQuestionId String?               @map("pyq_question_id")
  pyqQuestion   PreviousYearQuestion? @relation(fields: [pyqQuestionId], references: [id], onDelete: Cascade)

  testResponseId String?       @unique @map("test_response_id")
  testResponse   TestResponse? @relation(fields: [testResponseId], references: [id], onDelete: SetNull)

  tagCategory MistakeTagCategory @map("tag_category")
  note        String?

  resolved   Boolean   @default(false)
  resolvedAt DateTime? @map("resolved_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, tagCategory])
  @@index([userId, questionId])
  @@index([userId, pyqQuestionId])
  @@map("mistake_vault")
}

// ─────────────────────────────────────────────────────────────────────────
// Offline OMR workflow (print a set, scan and grade it later)
// ─────────────────────────────────────────────────────────────────────────

// A printable offline mock set: a fixed batch of questions assigned a
// human-readable serialCode (e.g. "VN-JNV-007") so grading can be
// requested later by that code instead of re-uploading the question set.
// questionIds/answerKey are Json rather than relations because a set is a
// point-in-time snapshot of whatever was actually printed — if the source
// question is edited afterward, an already-printed sheet's key must stay
// exactly what a student has in hand, not silently follow the edit.
model OfflineMockSession {
  id         String @id @default(cuid())
  serialCode String @unique @map("serial_code")

  // Reuses the existing ExamType enum (matches every other exam-typed
  // field in this schema) rather than a free-form String, so this can't
  // drift out of sync with JNVST/AISSEE/RMS/DPS/OTHER.
  examType   ExamType @map("exam_type")
  classLevel Int      @map("class_level")

  totalQuestions Int @map("total_questions")

  // Question ids in print order. Values match Question.id or
  // PreviousYearQuestion.id depending on which bank the set was drawn
  // from — deliberately not a DB-level relation, for the snapshot reason
  // above.
  questionIds Json @map("question_ids")

  // Keyed by question number (1-based, matching the printed sheet) to the
  // correct bubble option. Uses "A"|"B"|"C"|"D" — not a 0-3 index — to
  // match packages/engine/src/omrEvaluator.ts's BubbleOption /
  // OmrAnswerKeyEntry shape exactly, e.g. { "1": "B", "2": "D", ... }, so
  // this can be handed straight to evaluateOmrSheet() with no translation
  // once the scan-and-grade step is built.
  answerKey Json @map("answer_key")

  // Set only when a signed-in student generated this set (vs. an
  // anonymous print, e.g. from a shared library computer).
  userId String? @map("user_id")
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Populated once the filled sheet is scanned and uploaded (Supabase
  // Storage), ahead of grading actually running against it.
  scannedImageUrl String? @map("scanned_image_url")

  // Set once grading has run. Mirrors
  // packages/engine/src/omrEvaluator.ts's OmrSheetEvaluationSummary shape:
  // { responses, totalMarks, correctCount, incorrectCount,
  //   unattemptedCount, invalidCount }.
  gradingResult Json? @map("grading_result")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([examType, classLevel])
  @@map("offline_mock_sessions")
}

// ─────────────────────────────────────────────────────────────────────────
// Media catalog
// ─────────────────────────────────────────────────────────────────────────

// A short/pod/clinic in the media learning library. videoUrl/audioUrl are
// nullable — an item can exist in the catalog (title, description, linked
// topic/hack) before its asset file has actually been uploaded.
model MediaItem {
  id          String    @id @default(cuid())
  // Bilingual title/description, e.g. { "en": "...", "hi": "..." }
  title       Json
  description Json
  mediaType   MediaType @map("media_type")

  durationSeconds Int     @map("duration_seconds")
  videoUrl        String? @map("video_url")
  audioUrl        String? @map("audio_url")
  thumbnailUrl    String? @map("thumbnail_url")
  // Bilingual transcript for the audio-pod player's transcript toggle.
  transcript      Json?

  topicId String? @map("topic_id")
  topic   Topic?  @relation(fields: [topicId], references: [id], onDelete: SetNull)

  vedicSpeedHackId String?         @map("vedic_speed_hack_id")
  vedicSpeedHack   VedicSpeedHack? @relation(fields: [vedicSpeedHackId], references: [id], onDelete: SetNull)

  targetExams ExamType[] @map("target_exams")

  // "Inherits from owning Topic" when topicId is set (null = use
  // topic.targetClass, itself null-means-CLASS_6) — same convention as
  // Question.targetClass. When topicId is null, null instead means "both
  // classes" (the Product.targetClass convention), since there's no topic
  // to inherit from. Resolved server-side by lib/media/mediaService.ts.
  targetClass ContentClassLevel? @map("target_class")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([topicId])
  @@index([mediaType])
  @@map("media_items")
}

// ─────────────────────────────────────────────────────────────────────────
// Blog (organic SEO content pipeline)
// ─────────────────────────────────────────────────────────────────────────

// Category is a plain string, not an enum: new categories can be added from
// the admin panel without a schema migration. apps/web's admin/blog code
// defines the canonical starting set of category labels as a shared
// constant for consistent labeling/filtering, without enforcing it here.
model BlogPost {
  id       String         @id @default(cuid())
  title    String
  slug     String         @unique
  category String
  // Short summary — doubles as the article-card blurb and the meta description.
  excerpt  String
  // Markdown body, rendered to HTML at request time.
  content  String
  status   BlogPostStatus @default(DRAFT)

  // Set when a post transitions DRAFT -> PUBLISHED (via the admin "Publish
  // Now" action); cleared again if it's unpublished back to DRAFT.
  publishedAt DateTime? @map("published_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, publishedAt])
  @@index([category])
  @@map("blog_posts")
}

// Homepage hero's gamified lead-gen widget (apps/web/src/components/marketing/SpeedChallengeWidget.tsx) —
// fully admin-managed via /admin/speed-challenge, not hardcoded in the client.
model SpeedChallengeQuestion {
  id        String   @id @default(cuid())
  question  String
  options   String[]
  correct   Int
  topic     String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("speed_challenge_questions")
}

// One row per completed (or 3-strike-ended) Speed Challenge run — the
// widget's lead-capture form POSTs here via /api/speed-challenge/lead-capture,
// which upserts the User by phone and links the attempt to it. This is the
// "student user log" the admin leads view (/admin/speed-challenge/leads) reads.
model SpeedChallengeAttempt {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetClass   Int      @map("target_class")
  score         Int
  strikes       Int
  questionCount Int      @map("question_count")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("speed_challenge_attempts")
}

// ─────────────────────────────────────────────────────────────────────────
// Institute Suite (omrtest.vedicneev.com) — B2B batch OMR grading,
// section-wise analytics, and the Mistake Vault sold to coaching institutes.
// Deliberately its own model cluster rather than reusing Subscription/
// Purchase (those are per-User consumer-product billing; an institute's
// subscription is billed once per institute, shared across every admin and
// student under it) or MistakeVault directly (a scanned institute sheet has
// no signed-in User until/unless that student separately has a VedicNeev
// account — see OmrUpload's own comment on why it stores roster identity,
// not a User FK).
// ─────────────────────────────────────────────────────────────────────────

enum InstituteTier {
  STARTER
  GROWTH
  ENTERPRISE
}

enum InstituteAdminRole {
  OWNER
  STAFF
}

// Append-only reasons for a credit_ledger row — never delete/edit a row to
// "fix" a balance; write a new row with the correcting delta instead, so
// SUM(delta) always reconstructs an honest history for a support dispute.
enum CreditLedgerReason {
  MONTHLY_GRANT
  TOPUP_PURCHASE
  SCAN_CONSUMED
  SCAN_REJECTED_REFUND
  MANUAL_ADJUSTMENT
}

enum OmrUploadStatus {
  QUEUED
  GRADED
  REJECTED_DUPLICATE
  REJECTED_ROSTER_MISMATCH
  REJECTED_UNREADABLE
  NEEDS_MANUAL_REVIEW
}

model Institute {
  id         String        @id @default(cuid())
  name       String
  slug       String        @unique
  tier       InstituteTier
  // Report-card white-labeling (Growth: toggle-able; Enterprise: always on
  // with no VedicNeev credit — that distinction is enforced in app code,
  // not the schema, off `tier` + `InstituteSubscription`).
  logoUrl    String?       @map("logo_url")
  brandColor String?       @map("brand_color")
  createdAt  DateTime      @default(now()) @map("created_at")

  branches     InstituteBranch[]
  admins       InstituteAdmin[]
  subscription InstituteSubscription?
  creditLedger InstituteCreditLedger[]
  testBatches  TestBatch[]

  @@map("institutes")
}

// Enterprise tier's "multi-branch logins" — a branch is purely an
// organizational label an InstituteAdmin/TestBatch can be scoped to; credits
// and billing stay at the Institute level (one shared pool), not per-branch.
model InstituteBranch {
  id          String    @id @default(cuid())
  instituteId String    @map("institute_id")
  institute   Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  name        String
  city        String?
  createdAt   DateTime  @default(now()) @map("created_at")

  admins      InstituteAdmin[]
  testBatches TestBatch[]

  @@index([instituteId])
  @@map("institute_branches")
}

// One row per human who can sign in to omrtest.vedicneev.com for an
// Institute. Identity/auth stays on the existing User row (same
// phone-OTP-to-Supabase-session bridge apps/web already uses — see
// whatsappOtpServer.ts) rather than a parallel account system; this table
// only adds the institute-scoped authorization on top of that identity.
// userId is unique because today one person administers exactly one
// institute — revisit if a franchise operator ever needs to run several.
model InstituteAdmin {
  id          String             @id @default(cuid())
  userId      String             @unique @map("user_id")
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  instituteId String             @map("institute_id")
  institute   Institute          @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  branchId    String?            @map("branch_id")
  branch      InstituteBranch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  role        InstituteAdminRole @default(OWNER)
  createdAt   DateTime           @default(now()) @map("created_at")

  @@index([instituteId])
  @@index([branchId])
  @@map("institute_admins")
}

// Reuses the existing SubscriptionStatus enum (ACTIVE/EXPIRED/CANCELLED) —
// same lifecycle shape as the consumer Subscription model, just billed to
// an Institute instead of a User.
model InstituteSubscription {
  id                 String             @id @default(cuid())
  instituteId        String             @unique @map("institute_id")
  institute          Institute          @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  tier               InstituteTier
  // Scans granted per billing period at this tier — null means unlimited
  // (Enterprise), matching OmrUpload/credit-check code treating a null
  // grant as "skip the balance check entirely" rather than "zero credits".
  monthlyCreditGrant Int?               @map("monthly_credit_grant")
  currentPeriodStart DateTime           @map("current_period_start")
  currentPeriodEnd   DateTime           @map("current_period_end")
  razorpaySubId      String?            @map("razorpay_subscription_id")
  status             SubscriptionStatus @default(ACTIVE)
  createdAt          DateTime           @default(now()) @map("created_at")

  @@map("institute_subscriptions")
}

// Append-only credit ledger — an institute's live balance is always
// SUM(delta) WHERE institute_id = X AND created_at >= current_period_start,
// computed on read rather than cached, so a disputed/duplicate scan can be
// refunded with a new offsetting row (SCAN_REJECTED_REFUND) instead of an
// update that erases the audit trail a billing dispute needs.
model InstituteCreditLedger {
  id          String             @id @default(cuid())
  instituteId String             @map("institute_id")
  institute   Institute          @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  delta       Int
  reason      CreditLedgerReason
  testBatchId String?            @map("test_batch_id")
  omrUploadId String?            @map("omr_upload_id")
  createdAt   DateTime           @default(now()) @map("created_at")

  @@index([instituteId, createdAt])
  @@map("institute_credit_ledger")
}

// One created test (a printed OMR set + its answer key), scoped to an
// Institute. sections/answerKey are Json, same rationale as
// OfflineMockSession above: a point-in-time snapshot of exactly what was
// printed, immune to a later edit of some shared question bank.
model TestBatch {
  id                String           @id @default(cuid())
  instituteId       String           @map("institute_id")
  institute         Institute        @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  branchId          String?          @map("branch_id")
  branch            InstituteBranch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  batchName         String           @map("batch_name")
  // Institute-chosen code, unique per institute (not globally) — e.g.
  // "PHY-MOCK-04". The pre-download metadata gate refuses to create a
  // second TestBatch reusing a code still active for the same institute.
  testCode          String           @map("test_code")
  subject           String?
  // Free-text, not an enum — a coaching institute's exam categories are
  // unbounded (Engineering/Medical/Board/Civil Services/Custom); this is
  // purely a reporting/branding label, unlike apps/web's own ExamType enum
  // which stays scoped to that consumer product's fixed exam boards.
  // Optional: not collected by the /tests/new metadata gate (Batch
  // Name/Test Code/Subject/Total Students/Total Questions only) — set
  // later from the dashboard once it's actually needed for reporting.
  examCategory      String?          @map("exam_category")
  totalStudents     Int              @map("total_students")
  // Needed up front to generate the OMR sheet geometry itself
  // (packages/engine's generateOmrSheetSpec) — unlike sections/answerKey
  // below, a sheet literally can't be printed without knowing this.
  totalQuestions    Int              @map("total_questions")
  // Both nullable: an institute commonly finalizes section weightings and
  // the actual answer key closer to exam day, well after sheets are
  // printed and distributed — TestBatch legitimately exists in a
  // "sheets generated, answer key pending" state. The (future) grading
  // service refuses to grade an OmrUpload against a null answerKey rather
  // than this column enforcing it.
  sections          Json?
  answerKey         Json?            @map("answer_key")
  sheetsGeneratedAt DateTime?        @map("sheets_generated_at")
  createdAt         DateTime         @default(now()) @map("created_at")

  rosterEntries TestBatchRosterEntry[]
  omrUploads    OmrUpload[]

  @@unique([instituteId, testCode])
  @@index([instituteId])
  @@map("test_batches")
}

// One row per student slot in a TestBatch, created up-front (sequentially
// numbered) the moment the batch's metadata form is submitted — this is
// what makes "download one blank master and photocopy it" self-defeating:
// every printed sheet already carries a distinct, pre-assigned sheetToken
// before a single copy exists, so 300 photocopies of one sheet still only
// ever match ONE roster entry at ingestion (see OmrUpload's dedup rule).
model TestBatchRosterEntry {
  id             String    @id @default(cuid())
  testBatchId    String    @map("test_batch_id")
  testBatch      TestBatch @relation(fields: [testBatchId], references: [id], onDelete: Cascade)
  // 1-based, assigned in creation order — the pure-numeric value actually
  // bubbled onto the sheet's roll-number grid (packages/engine's
  // OmrSheetSpec.rollNumberGrid only understands digits, not the
  // TESTCODE- prefix). rollNumber below is the human-readable display
  // string derived from this at print/render time, never bubbled directly.
  sequenceNumber Int       @map("sequence_number")
  // Human-readable on the printed sheet, e.g. "PHY-MOCK-04-0001" — derived
  // from testCode + sequenceNumber, stored (not computed on read) so it
  // stays fixed even if the TestBatch's testCode is ever edited later.
  rollNumber     String    @map("roll_number")
  studentName    String?   @map("student_name")
  // Opaque, unguessable, purely numeric — bubbled onto the sheet's own
  // second digit-grid (OmrSheetSpec.sheetTokenGrid) using the same
  // detection pipeline as answers and the roll number, no barcode/QR
  // scanner needed. This (not rollNumber, which is guessable/collidable
  // across batches) is the actual key the anti-fraud ingestion check
  // matches against.
  sheetToken     String    @unique @map("sheet_token")
  downloadedAt   DateTime? @map("downloaded_at")
  // Set the moment a scan matching this token grades successfully. A
  // second scan presenting the same token after this is set is rejected as
  // REJECTED_DUPLICATE rather than overwriting the first result.
  consumedAt     DateTime? @map("consumed_at")

  // 1:many now (see OmrUpload's own comment) — a rejected scan must be
  // re-uploadable, so a roster entry can accumulate more than one attempt
  // before (or instead of) a successful grade.
  omrUploads OmrUpload[]

  @@unique([testBatchId, sequenceNumber])
  @@index([testBatchId])
  @@map("test_batch_roster_entries")
}

// One row per scanned sheet image submitted for grading, whatever the
// outcome — a rejection is logged here too (never silently dropped) so an
// institute admin can see exactly why a given sheet didn't count, and so
// REJECTED_* rows never consume a credit (see the ledger-write ordering
// note above InstituteCreditLedger's writer in the grading service, once
// built: credit-consumed row is written only after status flips to GRADED).
// Deliberately allows MULTIPLE OmrUpload rows per roster entry (rosterEntryId
// is indexed, not @unique) — a rejected scan (blurry photo, misread token)
// must still be re-uploadable, so uniqueness can't live on the FK itself.
// The actual "already graded" guarantee is TestBatchRosterEntry.consumedAt
// (set only by the one upload that successfully grades), checked inside the
// grading transaction — see apps/omrtest/src/lib/omr/gradeUpload.ts.
model OmrUpload {
  id             String                @id @default(cuid())
  testBatchId    String                @map("test_batch_id")
  testBatch      TestBatch             @relation(fields: [testBatchId], references: [id], onDelete: Cascade)
  rosterEntryId  String?               @map("roster_entry_id")
  rosterEntry    TestBatchRosterEntry? @relation(fields: [rosterEntryId], references: [id], onDelete: SetNull)
  imageUrl       String                @map("image_url")
  // Perceptual hash (not exact-byte hash) so a rescanned/re-photographed
  // copy of the same physical sheet still collides for dedup purposes.
  imageHash      String                @map("image_hash")
  status         OmrUploadStatus       @default(QUEUED)
  rejectReason   String?               @map("reject_reason")
  // Raw per-question marked-bubble reads (OmrQuestionScan[]), captured at
  // analysis time for EVERY matched-and-readable sheet regardless of
  // whether grading happened yet — this is what makes a QUEUED-for-no-
  // answer-key-yet upload re-gradable later (see the answer-key route)
  // without re-fetching and re-decoding the original image. Null for a
  // sheet that never got past corner/token detection (REJECTED_UNREADABLE/
  // ROSTER_MISMATCH/DUPLICATE) — there's nothing to store for those.
  detectedScans  Json?                 @map("detected_scans")
  // The scored outcome (packages/engine's OmrSheetEvaluationSummary), set
  // only once status flips to GRADED — separate from detectedScans above
  // because a QUEUED row legitimately has marks but no score yet.
  gradingResult  Json?                 @map("grading_result")
  creditConsumed Boolean               @default(false) @map("credit_consumed")
  createdAt      DateTime              @default(now()) @map("created_at")

  @@unique([testBatchId, imageHash])
  @@index([testBatchId, status])
  @@index([rosterEntryId])
  @@map("omr_uploads")
}

// ─────────────────────────────────────────────────────────────────────────
// Typing Test Suite (typingtest.vedicneev.com) — government-exam-style
// typing simulation, official Gross/Net Speed + Full/Half Mistake grading
// (see packages/engine/src/typingEvaluation.ts), and the "Typing Speed &
// Logic" dual-mode module. Its own TypingSubscription/plan rather than
// reusing Subscription above, same split already used for
// InstituteSubscription vs Subscription: that model is a K-8 ExamType
// paywall billed per parent, this is billed per typing-test user
// independently of any JNVST/AISSEE/RMS/DPS plan they may also hold.
// ─────────────────────────────────────────────────────────────────────────

enum TypingKeyboardLayout {
  QWERTY
  INSCRIPT
  REMINGTON
}

// DISABLED = the Backspace key is rejected client-side for the whole
// attempt (some government exams run this way). ENABLED_WITH_PENALTY =
// backspace is allowed but every use is counted (TypingAttempt.backspaceCount)
// for display — it does not itself change the mistake grading, which is
// always computed by comparing the final typed text to the passage.
enum BackspacePolicy {
  DISABLED
  ENABLED_WITH_PENALTY
}

enum TypingSubscriptionPlan {
  FREE
  PRO
}

// One catalog entry a candidate can practice against, e.g. "RRB NTPC —
// English". `name` is bilingual (same {en, hi, ...} Json convention as
// Question.content below) since the catalog listing itself is shown in
// whichever UI language the visitor picked, even though the passage body
// a candidate types is always in a single fixed `language`.
model TypingExam {
  id                          String               @id @default(cuid())
  slug                        String               @unique
  name                        Json
  // Free-text issuing body, e.g. "RRB NTPC", "Allahabad High Court",
  // "UPSSSC", "AIIMS" — a growing, informally-governed list, so a plain
  // String rather than an enum that would need a migration per new exam.
  organization                String
  language                    Language
  layout                      TypingKeyboardLayout
  durationSeconds             Int                  @map("duration_seconds")
  // Standard-word-length key count a full-marks candidate would type in
  // durationSeconds (word = 5 key depressions including spaces) — drives
  // the exam listing's displayed target speed, not used in grading itself
  // (grading always measures the candidate's own typed text).
  totalKeyDepressionsRequired Int                  @map("total_key_depressions_required")
  backspacePolicy             BackspacePolicy      @default(ENABLED_WITH_PENALTY) @map("backspace_policy")
  difficulty                  Difficulty           @default(MEDIUM)
  isActive                    Boolean              @default(true) @map("is_active")
  createdAt                   DateTime             @default(now()) @map("created_at")
  updatedAt                   DateTime             @updatedAt @map("updated_at")

  passages          TypingPassage[]
  attempts          TypingAttempt[]
  candidateProfiles TypingCandidateProfile[]

  @@index([isActive])
  @@map("typing_exams")
}

// A single practice/test passage under one TypingExam. Not bilingual —
// unlike the catalog entry above, the body a candidate actually types is
// always in exactly the one language their chosen exam is scored in.
model TypingPassage {
  id                 String     @id @default(cuid())
  examId             String     @map("exam_id")
  exam               TypingExam @relation(fields: [examId], references: [id], onDelete: Cascade)
  content            String
  wordCount          Int        @map("word_count")
  keyDepressionCount Int        @map("key_depression_count")
  isActive           Boolean    @default(true) @map("is_active")
  createdAt          DateTime   @default(now()) @map("created_at")

  attempts TypingAttempt[]

  @@index([examId, isActive])
  @@map("typing_passages")
}

// One completed typing run. Graded by packages/engine/src/typingEvaluation.ts
// from `typedText` vs the target text — the numeric fields here are that
// function's output, persisted rather than recomputed on every read
// (dashboard history + leaderboard both query these directly). Either
// (examId + passageId) is set for a catalog attempt, or customPassageText
// is set for a Custom Text Practice attempt (see app/practice/custom) —
// exactly one of the two, enforced by app/api/attempts/route.ts, the same
// "one FK-shaped choice per row, enforced by the writer" convention
// MistakeVault's questionId/pyqQuestionId split already uses. A custom
// attempt has no examId, so it's automatically excluded from every
// examId-scoped query (leaderboards, the ghost-race personal-best lookup)
// without those queries needing to know custom mode exists.
model TypingAttempt {
  id     String @id @default(cuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  examId    String?        @map("exam_id")
  exam      TypingExam?    @relation(fields: [examId], references: [id], onDelete: Restrict)
  passageId String?        @map("passage_id")
  passage   TypingPassage? @relation(fields: [passageId], references: [id], onDelete: Restrict)

  // Set only for a Custom Text Practice attempt — the pasted-in text graded
  // against, in place of a TypingPassage row.
  customPassageText String? @map("custom_passage_text")

  typedText        String   @map("typed_text")
  grossSpeedWpm    Float    @map("gross_speed_wpm")
  netSpeedWpm      Float    @map("net_speed_wpm")
  accuracyPercent  Float    @map("accuracy_percent")
  fullMistakes     Int      @map("full_mistakes")
  halfMistakes     Int      @map("half_mistakes")
  keyDepressions   Int      @map("key_depressions")
  backspaceCount   Int      @default(0) @map("backspace_count")
  timeTakenSeconds Float    @map("time_taken_seconds")
  completedAt      DateTime @default(now()) @map("completed_at")

  logicAttempt TypingLogicAttempt?

  @@index([userId, examId])
  @@index([examId, netSpeedWpm])
  @@map("typing_attempts")
}

// Question bank for the "Typing Speed & Logic" dual-mode module — a
// rapid-fire aptitude/reasoning quiz a candidate takes immediately after a
// timed typing passage. Bilingual like Question.content: `prompt` is
// { "en": "...", "hi": "..." }, `options` is { "en": ["...", ...], "hi":
// ["...", ...] } with matching order/length per language.
model TypingLogicQuestion {
  id           String     @id @default(cuid())
  prompt       Json
  options      Json
  correctIndex Int        @map("correct_index")
  topic        String
  difficulty   Difficulty @default(MEDIUM)
  isActive     Boolean    @default(true) @map("is_active")
  createdAt    DateTime   @default(now()) @map("created_at")

  @@index([isActive, topic])
  @@map("typing_logic_questions")
}

// The logic-quiz result for one TypingAttempt — at most one per attempt
// (a candidate either takes the dual-mode quiz right after submitting that
// attempt, or doesn't; there's no separate standalone quiz entry point).
model TypingLogicAttempt {
  id                String        @id @default(cuid())
  typingAttemptId   String        @unique @map("typing_attempt_id")
  typingAttempt     TypingAttempt @relation(fields: [typingAttemptId], references: [id], onDelete: Cascade)
  questionsAnswered Int           @map("questions_answered")
  correctCount      Int           @map("correct_count")
  avgResponseMs     Float         @map("avg_response_ms")
  logicScore        Float         @map("logic_score")
  createdAt         DateTime      @default(now()) @map("created_at")

  @@map("typing_logic_attempts")
}

// One row per typing candidate who has declared an active target exam —
// separate from TypingSubscription below (billing-only, see that model's
// own banner comment) since a candidate can switch their prep focus
// freely and for free, independent of plan. Absence of a row simply means
// "no target chosen yet" (the dashboard prompts the selector), matching
// TypingSubscription's own "no row = FREE" convention.
model TypingCandidateProfile {
  id     String @id @default(cuid())
  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  targetExamId String?     @map("target_exam_id")
  targetExam   TypingExam? @relation(fields: [targetExamId], references: [id], onDelete: SetNull)

  // Free-text target exam for a candidate whose exam isn't in the catalog
  // yet (or who just wants general practice, not tied to a specific exam).
  // Mutually exclusive with targetExamId — exactly one of the two is set,
  // enforced by app/api/profile/target-exam/route.ts, the same
  // one-FK-or-free-text-field-per-row convention TypingAttempt already
  // uses for passageId vs customPassageText.
  customTargetExamName String? @map("custom_target_exam_name")

  // Daily typing-practice streak — any TypingAttempt (catalog or custom)
  // bumps this, updated inline in app/api/attempts/route.ts right after the
  // attempt is persisted. lastAttemptDate is a calendar-day marker (not a
  // precise timestamp) purely so "same day again" doesn't double-count.
  currentStreak   Int       @default(0) @map("current_streak")
  longestStreak   Int       @default(0) @map("longest_streak")
  lastAttemptDate DateTime? @map("last_attempt_date")

  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("typing_candidate_profiles")
}

// typingtest.vedicneev.com's own blog — deliberately separate from
// apps/web's BlogPost (English-only, K-8-topic) rather than adding a
// language field there: different content domain, different app, and
// bilingual from day one via the same flat {en,hi} Json convention every
// other bilingual field in this schema already uses. Reuses
// BlogPostStatus rather than a duplicate enum.
model TypingBlogPost {
  id      String @id @default(cuid())
  slug    String @unique
  title   Json // { en, hi }
  excerpt Json // { en, hi }
  content Json // { en, hi } — Markdown, rendered to HTML at request time

  category String

  status      BlogPostStatus @default(PUBLISHED)
  publishedAt DateTime?      @map("published_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, publishedAt])
  @@map("typing_blog_posts")
}

// A typing-test user's paywall state — see this section's own banner
// comment for why it's separate from Subscription. One row per user; FREE
// is the implicit default for anyone with no row at all (checked via
// packages/engine/src/typingEntitlements.ts, not by relying on a row
// always existing).
model TypingSubscription {
  id                String                 @id @default(cuid())
  userId            String                 @unique @map("user_id")
  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan              TypingSubscriptionPlan @default(FREE)
  status            SubscriptionStatus     @default(ACTIVE)
  validUntil        DateTime?              @map("valid_until")
  razorpayOrderId   String?                @map("razorpay_order_id")
  razorpayPaymentId String?                @map("razorpay_payment_id")
  amountPaid        Float                  @default(0) @map("amount_paid")
  createdAt         DateTime               @default(now()) @map("created_at")

  @@map("typing_subscriptions")
}
