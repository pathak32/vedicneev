{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "**/.env"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "@vedicneev/db#build": {
      "outputs": [
        "../../node_modules/@prisma/client/**",
        "../../node_modules/.prisma/client/**"
      ]
    },
    "@vedicneev/engine#build": {
      "outputs": []
    },
    "@vedicneev/auth#build": {
      "outputs": []
    },
    "@vedicneev/ui#build": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": [
        "^build"
      ]
    },
    "type-check": {
      // Both: dependency packages built (^build) AND this package's own
      // build (plain "build") — a Next.js app's tsconfig.json includes
      // .next/types/**/*.ts, generated only by that app's own `next build`;
      // without the self-dependency, turbo can run type-check before that
      // build finishes writing those files (TS6053: file not found).
      "dependsOn": [
        "^build",
        "build"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ]
    },
    "test:e2e": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    },
    "clean": {
      "cache": false
    },
    "generate": {
      "cache": false
    }
  },
  "globalEnv": [
    "DATABASE_URL",
    "DIRECT_URL",
    "NEXT_PUBLIC_APP_URL",
    "ADMIN_ACCESS_KEY",
    "RAZORPAY_KEY_ID",
    "RAZORPAY_KEY_SECRET",
    "WHATSAPP_PHONE_NUMBER_ID",
    "WHATSAPP_ACCESS_TOKEN",
    "WHATSAPP_API_VERSION",
    "WHATSAPP_TEMPLATE_NAME",
    "WHATSAPP_TEMPLATE_LANG",
    "WHATSAPP_TEMPLATE_BUTTON_TYPE",
    "CRON_SECRET",
    "NEXT_PUBLIC_SUPABASE_URL",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY",
    "SUPABASE_SERVICE_ROLE_KEY",
    "NEXT_PUBLIC_TYPINGTEST_APP_URL",
    "NEXT_PUBLIC_COOKIE_DOMAIN",
    "NEXT_PUBLIC_INSTITUTE_APP_URL"
  ]
}