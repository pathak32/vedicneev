# Vedic Neev — production environment template.
#
# Copy this to your Vercel project's Environment Variables (Production scope),
# or to a local `.env.production` for a production-mode smoke test. See
# `.env.example` for the local-dev version of this file (same variables,
# safe to leave the paid-integration ones unset there).
#
# Every integration below (Supabase, Razorpay, WhatsApp) runs a clearly
# labeled mock fallback in code whenever its variables are unset — nothing
# silently pretends to be live. Setting the real values here is what flips
# each one over; no code changes are required.

# ── Supabase / Prisma (packages/db) ─────────────────────────────────────
# packages/db's schema targets Supabase Postgres. apps/web does not yet call
# the database directly (all app state is client-side, see project README);
# these variables provision the database itself via `npm run db:push` /
# `npm run db:seed`, ahead of that wiring landing.

# Pooled connection (via Supabase's pgbouncer, port 6543) — used at runtime.
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:6543/postgres?pgbouncer=true

# Direct connection (port 5432, no pgbouncer) — required for `prisma db push`
# and `prisma migrate deploy`, which need a session-mode connection.
DIRECT_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# Public client config (safe to expose to the browser). Not yet read by any
# apps/web code — reserved for when a Supabase client is wired into the app.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── Razorpay (apps/web/src/lib/payments/razorpayServer.ts) ──────────────
# Both unset → mock checkout (a "Simulate Successful Payment" demo flow, no
# real gateway or charge). Both set → real order creation + HMAC-SHA256
# signature verification against Razorpay's live API.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── WhatsApp Cloud API (apps/web/app/api/whatsapp/send-report/route.ts) ─
# Both unset → mock dispatch (the Meta-shaped payload is logged server-side,
# nothing is actually sent). Both set → a real POST to
# https://graph.facebook.com/v20.0/{WHATSAPP_PHONE_NUMBER_ID}/messages.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# ── App origin ────────────────────────────────────────────────────────
# Absolute base URL of this deployment. Used for metadataBase (OG/Twitter
# image resolution) in apps/web/app/layout.tsx; also the canonical origin to
# put on file for any future server-side link-building (WhatsApp report
# links are currently built client-side from window.location instead).
NEXT_PUBLIC_APP_URL=https://vedicneev.com
