# Vedic Neev — production environment template.
#
# Copy every key below into your Vercel project's Environment Variables
# (Production scope; add to Preview too if preview deploys should hit the
# same Supabase project — otherwise give Preview its own). See
# `.env.example` for the local-dev version of this file (same variables,
# same required-vs-optional split).
#
# Required vs optional at a glance:
#   REQUIRED — DATABASE_URL, DIRECT_URL, NEXT_PUBLIC_APP_URL
#   OPTIONAL — RAZORPAY_*, WHATSAPP_* (each runs a clearly `mock: true`
#              fallback in code when unset — the app deploys and works in
#              demo mode even before you have real credentials)
#   NOT YET USED — NEXT_PUBLIC_SUPABASE_* (see the Auth section below)

# ── Database — REQUIRED (packages/db, apps/web/app/api) ──────────────────
# packages/db's schema targets Supabase Postgres. apps/web calls it
# directly on two flows: apps/web/app/api/auth/sync/route.ts (every OTP
# sign-in) and apps/web/app/api/exam/submit/route.ts (every mock-test
# submit) — both throw/500 without a reachable database. These variables
# are also what `npm run db:push` / `npm run db:seed` use to provision the
# schema and reference data (exam templates, question bank, media catalog).
# Everything else in the app (test-taking, results, Mistake Vault, Parent
# Command Center) runs client-side in Zustand + localStorage regardless.

# Pooled connection (via Supabase's pgbouncer, port 6543) — used at runtime.
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:6543/postgres?pgbouncer=true

# Direct connection (port 5432, no pgbouncer) — required for `prisma db push`
# and `prisma migrate deploy`, which need a session-mode connection.
DIRECT_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# ── Auth — nothing to configure yet ──────────────────────────────────────
# There is no real auth secret in this project today, in production or
# otherwise. Phone/OTP sign-in (apps/web/src/lib/auth/mockAuthProvider.ts)
# is a fully client-side mock — the OTP is always "123456", nothing is
# issued or verified server-side, and no JWT/session/cookie secret is read
# anywhere in the codebase. Do not treat this as an oversight to fill in:
# there is genuinely no server-side auth secret to set for the app to work
# as shipped. The two variables below are reserved for when real Supabase
# Phone Auth replaces the mock provider (see the comment at the top of
# mockAuthProvider.ts) but are NOT read by any code yet — setting them
# before that wiring lands has no effect.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── Razorpay (apps/web/src/lib/payments/razorpayServer.ts) — OPTIONAL ────
# Both unset → mock checkout (a "Simulate Successful Payment" demo flow, no
# real gateway or charge). Both set → real order creation + HMAC-SHA256
# signature verification against Razorpay's live API. Use LIVE (not test)
# keys from the Razorpay dashboard for a real production deployment.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── WhatsApp Cloud API (apps/web/app/api/whatsapp/send-report/route.ts) — OPTIONAL ─
# Both unset → mock dispatch (the Meta-shaped payload is logged server-side,
# nothing is actually sent). Both set → a real POST to
# https://graph.facebook.com/v20.0/{WHATSAPP_PHONE_NUMBER_ID}/messages.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# ── App origin — REQUIRED for correct metadata ───────────────────────────
# Absolute base URL of this deployment. Used for metadataBase — canonical
# URLs, OG/Twitter image resolution, robots.txt, and sitemap.xml — in
# apps/web/src/lib/siteConfig.ts. Must be the exact origin that actually
# serves production traffic (bare vs `www.`, and whichever of the custom
# domain or the vercel.app default is canonical) or every generated
# canonical/OG/sitemap URL will point at the wrong place.
NEXT_PUBLIC_APP_URL=https://vedicneev.com
