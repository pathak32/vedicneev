# Vedic Neev — local development environment template. Copy to `.env.local`
# (apps/web) or `.env` (repo root, for Prisma CLI commands run from there).
# See `.env.production.example` for the production/Vercel version of this
# same file — same variables, same required-vs-optional split.

# ── Database — REQUIRED (Prisma / Supabase Postgres) ────────────────────
# Backs apps/web/app/api/auth/sync/route.ts (called on every OTP sign-in) and
# apps/web/app/api/exam/submit/route.ts (called on every mock-test submit) —
# both call Prisma directly, so the app will throw/500 on those two flows
# without a reachable database. Everything else in the app (test-taking,
# results, Mistake Vault, Parent Command Center) runs entirely client-side
# in Zustand + localStorage and does not need the database.

# Pooled connection (via Supabase's pgbouncer, port 6543) — used at runtime.
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:6543/postgres?pgbouncer=true

# Direct connection (port 5432, no pgbouncer) — required for `prisma db push`
# / `prisma migrate deploy` and `npm run db:seed`, not by the running app.
DIRECT_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# ── Auth — optional, mock fallback ───────────────────────────────────────
# Leave all three unset to keep phone/OTP sign-in as a fully client-side
# mock (apps/web/src/lib/auth/mockAuthProvider.ts — the OTP is always
# "123456", nothing is issued or verified server-side). Set all three to
# switch on the real flow: apps/web/app/api/auth/whatsapp/send-otp and
# verify-otp routes, backed by apps/web/src/lib/auth/whatsappOtpServer.ts
# generates and hashes a 6-digit code (packages/db's PhoneOtp table),
# delivers it over WhatsApp (reusing WHATSAPP_ACCESS_TOKEN/
# WHATSAPP_PHONE_NUMBER_ID below — not Supabase's own phone provider, which
# only delivers via a separate paid SMS gateway), then bridges a verified
# code into a real Supabase session via the service-role Admin API. Once
# set, every route that checks isSupabaseAuthConfigured() (verify-payment,
# the OTP route itself) starts trusting the Supabase session over any
# client-supplied identity — see apps/web/src/lib/supabase/env.ts.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Secret — server-only, never expose to the client. From Supabase dashboard
# → Project Settings → API → service_role key. Used only by
# apps/web/src/lib/supabase/admin.ts to create/confirm the Supabase auth
# user and mint their session after a WhatsApp OTP verifies.
SUPABASE_SERVICE_ROLE_KEY=
#
# ── Ecosystem note: sharing identity with Vedic Mind AI (vedicmindai.in) ──
# Recognizing the same person on both vedicneev.com and vedicmindai.in
# requires that product's own deployment to point its NEXT_PUBLIC_SUPABASE_*
# / SUPABASE_SERVICE_ROLE_KEY at this SAME Supabase project rather than one
# of its own — that's what makes a Supabase-authenticated user a shared
# identity instead of two unrelated accounts. That's a change on Vedic Mind
# AI's side, outside this repo. User.vedicMindAiUserId (packages/db/prisma/schema.prisma)
# is reserved for whatever cross-app linking key that integration ends up
# needing.

# ── Institute Suite (omrtest.vedicneev.com) — optional until that app is deployed ──
# NEXT_PUBLIC_COOKIE_DOMAIN makes the Supabase session cookie set on this
# app's OTP login (see the Auth section above) also readable on
# omrtest.vedicneev.com, so an InstituteAdmin's session carries across
# without a second login — see packages/auth/src/env.ts's
# getSupabaseCookieOptions. Must be a LEADING-DOT parent domain
# (".vedicneev.com"), never a bare subdomain host. Leave unset in local dev:
# a Domain attribute doesn't work sensibly against "localhost", so omitting
# it just falls back to normal host-only cookies, which is what you want here.
NEXT_PUBLIC_COOKIE_DOMAIN=
# Where apps/web's header/footer "For Institutes" links point — see
# apps/web/src/lib/institute/instituteUrl.ts. Defaults to the real
# production subdomain if unset, so this only needs setting to point local
# dev at a locally-running apps/omrtest (e.g. http://localhost:3001).
NEXT_PUBLIC_INSTITUTE_APP_URL=https://omrtest.vedicneev.com
# Supabase Storage bucket for scanned OMR sheet photos, uploaded via
# apps/omrtest/app/api/tests/[id]/upload/route.ts using the SAME
# service-role admin client (SUPABASE_SERVICE_ROLE_KEY above) already used
# to bridge WhatsApp OTP logins — no separate credential needed. The bucket
# must exist and be PRIVATE (sheets can carry a student's name; the route
# only ever mints time-limited signed URLs, never a public one). Defaults
# to "omr-uploads" if unset.
SUPABASE_OMR_UPLOADS_BUCKET=omr-uploads

# ── Typing Test Suite (typingtest.vedicneev.com) — optional until that app is deployed ──
# Same shared-cookie-domain mechanism as the Institute Suite above — this
# app also needs NEXT_PUBLIC_COOKIE_DOMAIN set to the same leading-dot
# parent domain for a session started on apps/web to carry across.
# apps/typingtest's own login page links out to apps/web's real OTP login
# (via NEXT_PUBLIC_APP_URL) rather than duplicating that flow. Local dev
# default: http://localhost:3002 (apps/typingtest/package.json's `dev`
# script runs `next dev -p 3002`).
NEXT_PUBLIC_TYPINGTEST_APP_URL=https://typingtest.vedicneev.com

# Reuses the same Meta WhatsApp Cloud API credentials as apps/web's OTP
# delivery (WHATSAPP_ACCESS_TOKEN/WHATSAPP_PHONE_NUMBER_ID further below) —
# set on apps/typingtest's own Vercel Project too (a separate Project, so
# env vars aren't shared automatically) to enable the results page's "Send
# Scorecard to WhatsApp" button. Also requires a "typing_scorecard_ready"
# template approved in Meta Business Manager; see
# packages/engine/src/typingWhatsappScorecard.ts. Leave unset on that
# Project to leave the button disabled with a graceful message.

# ── Admin panel — REQUIRED to use /admin ─────────────────────────────────
# Shared-secret password for /admin (the blog draft queue). See
# apps/web/src/lib/admin/session.ts and apps/web/middleware.ts — this is a
# real, functional gate (HMAC-signed session cookie, not just a UI check),
# but it's a single shared password, not a per-user account system. Leave
# unset to disable /admin entirely (every request 503s at login).
ADMIN_ACCESS_KEY=

# ── Razorpay — optional, mock fallback ───────────────────────────────────
# Leave all three unset to run checkout in mock mode (a demo "Simulate
# Successful Payment" flow, no real gateway or charge). Set the key pair to
# enable real orders + HMAC-SHA256 signature verification in
# apps/web/src/lib/payments/razorpayServer.ts. RAZORPAY_WEBHOOK_SECRET is
# separate — generated when you add a webhook endpoint
# (https://vedicneev.com/api/webhook/payment) in the Razorpay dashboard —
# and is what the storefront's one-time-product checkout uses to confirm
# payment.captured/payment.failed events server-to-server.
#
# apps/omrtest's institutional billing (app/api/razorpay/,
# app/api/webhook/payment) reads these SAME three var names via its own
# apps/omrtest/src/lib/payments/razorpayServer.ts — but set them on THAT
# app's own Vercel Project too (a separate Project, so env vars aren't
# shared automatically — same caveat as apps/typingtest's WhatsApp
# credentials below). Reusing the same Razorpay merchant account's key
# values is fine; register a SECOND webhook endpoint in the Razorpay
# dashboard for omrtest (https://omrtest.vedicneev.com/api/webhook/payment)
# and use ITS own webhook secret for that Project's RAZORPAY_WEBHOOK_SECRET
# — it's a different secret per endpoint, not the same value as apps/web's.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── WhatsApp Cloud API — optional, mock fallback ─────────────────────────
# Leave both unset to run report dispatch AND OTP delivery in mock mode
# (the payload/code is logged server-side, nothing is actually sent). Set
# both to send real messages via apps/web/app/api/whatsapp/send-report/route.ts
# and, once the Auth vars above are also set, the WhatsApp OTP login routes
# under apps/web/app/api/auth/whatsapp/.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# All three optional, all have working defaults. WHATSAPP_API_VERSION
# defaults to "v20.0" (same version send-report hardcodes) and is also read
# by the OTP route and src/lib/whatsapp/whatsappService.ts.
# WHATSAPP_TEMPLATE_NAME/WHATSAPP_TEMPLATE_LANG must name a template (and
# one of its approved languages) already live in Meta's Authentication
# category with one body parameter (the code) — this project can't
# create/approve that template itself; default to "auth_login"/"en". A
# name or language that doesn't match an approved template exactly is what
# produces Meta error #132001 ("Template name does not exist in the
# translation").
WHATSAPP_API_VERSION=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=
# Optional, defaults to "NONE" (body-only, no button component sent) — set
# this only if the approved template above was actually created with a
# button. Meta's WhatsApp Manager defaults new Authentication templates to
# including a one-tap button, and sending a body-only payload against a
# template that has one is a common cause of error #131008 ("Required
# parameter is missing"). "COPY_CODE" for a "Copy Code" button, "URL" for a
# one-tap autofill/link button — check WhatsApp Manager → Message Templates
# → your template to see which (if either) it has.
WHATSAPP_TEMPLATE_BUTTON_TYPE=
# /admin/leads' "Approve & Send via WhatsApp" B2B outreach action — optional,
# defaults to WHATSAPP_TEMPLATE_NAME/LANG above if unset. Must name a
# template already live in Meta's Marketing category with ONE body
# parameter wide enough to hold the full generated outreach message (see
# apps/web/src/lib/admin/leadOutreach.ts's generateOutreachMessage). Leaving
# WHATSAPP_ACCESS_TOKEN/WHATSAPP_PHONE_NUMBER_ID unset runs this in the same
# mock mode as report dispatch above — nothing is actually sent.
WHATSAPP_LEAD_TEMPLATE_NAME=
WHATSAPP_LEAD_TEMPLATE_LANG=
# Required only for apps/web/app/api/whatsapp/webhook/route.ts (inbound
# messages + delivery statuses from Meta). Set this to any secret string of
# your choosing, then enter that same string as the "Verify token" when
# configuring the webhook URL in Meta App Dashboard → WhatsApp → Configuration —
# Meta echoes it back on the one-time GET handshake to prove you own the
# endpoint. Leave unset to have the webhook's GET handler always reject
# verification (503).
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# ── LinkedIn UGC Posts API — optional, mock fallback ─────────────────────
# Powers /admin/content's "Publish to LinkedIn" action
# (apps/web/app/api/linkedin/publish/route.ts). Leave both unset to run
# publishing in mock mode (the composed post text is logged server-side,
# nothing is actually sent, and the content block is still marked
# PUBLISHED so the admin flow is fully testable without real credentials).
# LINKEDIN_ACCESS_TOKEN needs the w_member_social (or w_organization_social
# for a Company Page) scope from a LinkedIn Marketing Developer Platform app.
LINKEDIN_ACCESS_TOKEN=
# The posting identity — a member URN ("urn:li:person:<id>") or Company
# Page URN ("urn:li:organization:<id>"), matching whichever scope the
# access token above was granted for.
LINKEDIN_AUTHOR_URN=

# ── Vercel Cron ───────────────────────────────────────────────────────────
# Required for app/api/cron/seed-sprints/route.ts (schedules next Sunday's
# National Sprints weekly — see apps/web/vercel.json's "crons" entry). Any
# secret string; Vercel automatically sends it back as
# `Authorization: Bearer <value>` when it invokes a Cron project's own
# routes, once this same value is set in that project's environment
# variables. Leave unset to have the route always reject with 500.
CRON_SECRET=

# ── App origin — REQUIRED for correct metadata ───────────────────────────
# Absolute base URL of this deployment — used for metadataBase (canonical
# URLs, OG/Twitter image resolution, robots.txt, sitemap.xml) in
# apps/web/src/lib/siteConfig.ts. Set this to your real deployed origin
# (e.g. https://vedicneev.com) so canonical/OG/sitemap URLs match production
# — if unset, or set without a protocol, it falls back to that same
# hardcoded default, NOT localhost, so don't rely on this being unset in dev
# if you need to see local URLs in generated metadata.
NEXT_PUBLIC_APP_URL=http://localhost:3000
