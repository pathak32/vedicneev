# Supabase — public client config (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Prisma / Supabase Postgres
# DATABASE_URL: pooled connection (via Supabase's pgbouncer, port 6543) — used at runtime
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:6543/postgres?pgbouncer=true

# DIRECT_URL: direct connection (port 5432) — used for migrations
DIRECT_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres
